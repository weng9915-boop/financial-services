//@version=6
// =============================================================================
//  APEX SESSION SMC  —  XAUUSD  (ADAPTIVE phases: detect A/M/D, don't assume it)
// -----------------------------------------------------------------------------
//  Phases are NOT hard-wired to sessions. Any session can accumulate, manipulate
//  or distribute. This tool:
//    • CLASSIFIES every completed session live — Accumulation (ranged),
//      Manipulation (swept a prior pool and reversed), or Distribution (expanded
//      directionally).
//    • COUNTS which session tends to play which role over all history (the
//      built-in "which session does what" backtest).
//    • PROJECTS the next session: after accumulation expect a sweep; after a
//      manipulation expect distribution in the reversal direction; after
//      distribution expect a pullback.
//
//  ENTRY (loose enough to actually fire): a LIQUIDITY POOL is swept and reclaimed
//  (the manipulation, happening now) + a confirming CANDLESTICK is the trigger.
//  HTF bias / momentum / CHoCH are OPTIONAL filters (off by default) you add to
//  tighten. LOCKED entry / SL (beyond the sweep) / TP. Non-repaint on bar close.
//  Not financial advice.
// =============================================================================

indicator("Apex Session SMC [XAUUSD]", "ApexSMC", overlay = true,
     max_boxes_count = 60, max_lines_count = 80, max_labels_count = 200, max_bars_back = 500)

// ============================== HELPERS ======================================
f_swLo(float p) => not na(p) and close[1] >= p and low  < p and close > p   // was above, raided below, reclaimed
f_swHi(float p) => not na(p) and close[1] <= p and high > p and close < p   // was below, raided above, reclaimed
f_phase(float o, float h, float l, float c, float pHi, float pLo, float refR) =>
    float rng = h - l
    bool swHi = not na(pHi) and h > pHi and c < pHi
    bool swLo = not na(pLo) and l < pLo and c > pLo
    bool manip = swHi or swLo
    bool directional = rng > 0 and math.abs(c - o) > 0.6 * rng
    bool big = na(refR) or rng > 1.2 * refR
    string ph = manip ? "Manip" : (big and directional) ? "Distrib" : "Accum"
    int dr = swHi ? -1 : swLo ? 1 : (c > o ? 1 : -1)
    [ph, dr]
f_chk(bool b) => b ? "✓" : "✗"
f_touches(float lvl, float tol, int look) =>
    int c = 0
    if not na(lvl)
        for i = 0 to look - 1
            if math.abs(high[i] - lvl) <= tol or math.abs(low[i] - lvl) <= tol
                c := c + 1
    c

// ============================== ① SESSIONS ===================================
gS = "① Sessions (UTC — adjust to your feed)"
asiaSess  = input.session("2300-0700", "Asia window", group = gS)
lonSess   = input.session("0700-1200", "London window", group = gS)
nySess    = input.session("1200-2100", "New York window", group = gS)
sessMode  = input.string("Any", "Trade in", options = ["Any","Kill zones only"], group = gS, tooltip = "Any = trade whichever session is manipulating. Kill zones = London + NY only.")

// ============================== ② PHASE DETECTION ============================
gF = "② Phase detection"
expandMult = input.float(1.2, "Distribution range ≥ avg ×", minval = 1.0, step = 0.1, group = gF, tooltip = "A session counts as Distribution (expansion) when its range exceeds this × the rolling average session range.")
dirThresh  = input.float(0.6, "Directional body ≥ range ×", minval = 0.1, maxval = 1.0, step = 0.05, group = gF)

// ============================== ③ ENTRY ======================================
gE = "③ Entry — confirm → retest → close"
usePoolSess = input.bool(true, "Pool: last completed session H/L", group = gE)
usePoolPD   = input.bool(true, "Pool: prev day H/L", group = gE)
usePoolPW   = input.bool(true, "Pool: prev week H/L", group = gE)
usePoolAsia = input.bool(true, "Pool: today's Asia H/L", group = gE)
useCandle   = input.bool(true, "Require a confirming candlestick", group = gE, tooltip = "The trigger: entry bar must be engulfing / pin-rejection / strong-body, not a doji.")
wickMult    = input.float(2.0, "  Pin wick ≥ body ×", minval = 0.5, step = 0.1, group = gE)
requireBias = input.bool(false, "Filter: HTF trend must agree", group = gE)
biasTF      = input.timeframe("60", "  HTF timeframe", group = gE)
requireMom  = input.bool(false, "Filter: momentum must agree", group = gE)
momTool     = input.string("Stochastic", "  Momentum tool", options = ["Stochastic","CCI"], group = gE)
requireChoch= input.bool(false, "Filter: CHoCH must confirm", group = gE)
pivLen      = input.int(3, "  CHoCH swing sensitivity", minval = 1, group = gE)
entryMode  = input.string("Retest zone (plan)", "Entry style", options = ["Retest zone (plan)","Sweep + candle (instant)"], group = gE, tooltip = "Retest (your plan): the sweep CONFIRMS direction, then WAIT for price to pull back and retest the level and CLOSE with a candle before entering. Instant: enter right on the sweep+candle bar.")
retestBars = input.int(20, "  Retest valid for (bars)", minval = 1, group = gE)
retestTol  = input.float(0.5, "  Retest tolerance × ATR", minval = 0.05, step = 0.05, group = gE)

// ============================== EXTRA CONFIRMATIONS (optional) ===============
gX = "Extra confirmations (optional)"
requireSMT = input.bool(false, "Require SMT divergence", group = gX, tooltip = "Smart-Money Technique: take the sweep only if a CORRELATED market fails to confirm the new extreme — divergence = a stop-raid (manipulation), not real flow.")
smtSym  = input.symbol("OANDA:XAGUSD", "  Correlated symbol", group = gX)
smtCorr = input.string("Positive", "  Correlation to gold", options = ["Positive","Inverse"], group = gX, tooltip = "Positive = moves WITH gold (silver XAGUSD). Inverse = moves AGAINST gold (DXY / USD).")
smtLen  = input.int(10, "  SMT swing lookback", minval = 2, group = gX)
useStrongSR = input.bool(false, "Require strong (tested) level", group = gX, tooltip = "Only trade a swept level that has been TOUCHED several times recently — a confirmed S/R, not a random level a single raid manufactured.")
srTouches = input.int(2, "  Min touches", minval = 1, group = gX)
srLook    = input.int(50, "  Touch lookback (bars)", minval = 5, maxval = 480, group = gX)
srTol     = input.float(0.4, "  Touch tolerance × ATR", minval = 0.05, step = 0.05, group = gX)

// ============================== ④ EXECUTION ==================================
gR = "④ Execution — locked levels"
atrLen   = input.int(14, "ATR length", minval = 1, group = gR)
stopMode = input.string("Beyond key level", "Stop placement", options = ["Beyond key level","Beyond sweep + ATR","Fixed $"], group = gR, tooltip = "Beyond key level = SL sits just past the swept/retested LEVEL (structure-based, not a ratio) — moves with price as the levels do.")
slDist   = input.float(10.0, "  Fixed $ stop distance", minval = 0.1, step = 0.5, group = gR)
slBuf    = input.float(0.3, "  Sweep buffer × ATR", minval = 0, step = 0.1, group = gR)
minStopAtr = input.float(0.8, "  Min stop × ATR (no micro-stops)", minval = 0, step = 0.1, group = gR, tooltip = "Floor on stop distance so a tiny sweep wick doesn't make a micro-stop that gets wicked out and a too-small trade. Wider stop = a touch lower RR but survivable.")
tgtMode  = input.string("Next key level", "Target mode", options = ["Next key level","Trail runner","Furthest pool","Fixed RR"], group = gR, tooltip = "Next key level = TP at the NEAREST opposing key level (structure, not a ratio). Trail runner = breakeven at +1R then trail for the furthest pips. Furthest pool = the farthest liquidity. Fixed RR = a set multiple.")
rr       = input.float(5.0, "Reward : Risk (Fixed RR mode)", minval = 0.5, step = 0.5, group = gR)
beR      = input.float(1.0, "  Runner: breakeven at +R", minval = 0.1, step = 0.1, group = gR)
trailAtr = input.float(2.0, "  Runner: trail × ATR", minval = 0.1, step = 0.1, group = gR, tooltip = "After breakeven the stop trails this far behind the extreme. Wider = lets it breathe and run further; tighter = banks sooner.")
maxRRcap = input.float(20.0, "  Runner: max RR cap", minval = 1, step = 1, group = gR)
cooldownBars = input.int(10, "Cooldown after a trade (bars)", minval = 0, group = gR)
useFailExit  = input.bool(true, "Cut on opposite sweep", group = gR)
useTimeStop  = input.bool(true, "Time stop", group = gR)
maxBars      = input.int(40, "  Max bars in trade", minval = 1, group = gR)

// ============================== ⑤ DISPLAY ====================================
gD = "⑤ Display"
showDash = input.bool(true, "Show dashboard", group = gD)
dashPos  = input.string("Top Right", "Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = gD)
drawLevels = input.bool(true, "Draw key levels / pools", group = gD)
colorHTF   = input.bool(true, "Color candles by HTF trend", group = gD, tooltip = "Green when the higher timeframe is up (close > its EMA50), red when down. Use it as a constant background bias read.")
htfColorTF = input.timeframe("60", "  HTF for candle color", group = gD)

// ============================== ⑥ SESSION SHADING ===========================
gV = "⑥ Session shading (UTC)"
drawSess = input.bool(true, "Shade sessions on chart", group = gV)
asiaAM = input.session("2300-0300", "Asia morning", group = gV)
asiaPM = input.session("0300-0700", "Asia noon", group = gV)
lonAM  = input.session("0700-0930", "London morning", group = gV)
lonPM  = input.session("0930-1200", "London noon", group = gV)
nyAM   = input.session("1200-1500", "New York morning", group = gV)
nyPM   = input.session("1500-2100", "New York noon", group = gV)

// ============================== CALCULATIONS =================================
atr = ta.atr(atrLen)

// key levels / pools
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1],  lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],   lookahead = barmerge.lookahead_on)

// optional HTF bias
htfClose = request.security(syminfo.tickerid, biasTF, close[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, biasTF, ta.ema(close, 50)[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
biasBull = htfClose > htfEma
biasBear = htfClose < htfEma

// HTF trend for candle coloring (independent custom TF)
htfcClose = request.security(syminfo.tickerid, htfColorTF, close[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfcEma   = request.security(syminfo.tickerid, htfColorTF, ta.ema(close, 50)[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfcUp = htfcClose > htfcEma
htfcDn = htfcClose < htfcEma

// optional momentum (state, not a same-bar cross)
stochK = ta.sma(ta.stoch(close, high, low, 14), 3)
stochD = ta.sma(stochK, 3)
cciV   = ta.cci(close, 20)
momBull = momTool == "CCI" ? cciV > -100 : stochK > stochD
momBear = momTool == "CCI" ? cciV <  100 : stochK < stochD

// optional CHoCH
ph_ = ta.pivothigh(pivLen, pivLen)
pl_ = ta.pivotlow(pivLen, pivLen)
var float lastPH = na
var float lastPL = na
if not na(ph_)
    lastPH := ph_
if not na(pl_)
    lastPL := pl_
chochUp = not na(lastPH) and ta.crossover(close, lastPH)
chochDn = not na(lastPL) and ta.crossunder(close, lastPL)
var int chochUpBar = na
var int chochDnBar = na
if chochUp
    chochUpBar := bar_index
if chochDn
    chochDnBar := bar_index
chochArmBull = not na(chochUpBar) and bar_index - chochUpBar <= 20
chochArmBear = not na(chochDnBar) and bar_index - chochDnBar <= 20

// ----- sessions: in/out + per-session OHLC for the day -----------------------
inAsia = not na(time(timeframe.period, asiaSess, "GMT+0"))
inLon  = not na(time(timeframe.period, lonSess,  "GMT+0"))
inNY   = not na(time(timeframe.period, nySess,   "GMT+0"))
inSession = inAsia or inLon or inNY
inKZ      = inLon or inNY
inSessionOK = sessMode == "Kill zones only" ? inKZ : true

newDay = timeframe.change("D")

var float asiaO = na
var float asiaH = na
var float asiaL = na
var float asiaC = na
if inAsia and not inAsia[1]
    asiaO := open
    asiaH := high
    asiaL := low
    asiaC := close
else if inAsia
    asiaH := math.max(asiaH, high)
    asiaL := math.min(asiaL, low)
    asiaC := close

var float lonO = na
var float lonH = na
var float lonL = na
var float lonC = na
if inLon and not inLon[1]
    lonO := open
    lonH := high
    lonL := low
    lonC := close
else if inLon
    lonH := math.max(lonH, high)
    lonL := math.min(lonL, low)
    lonC := close

var float nyO = na
var float nyH = na
var float nyL = na
var float nyC = na
if inNY and not inNY[1]
    nyO := open
    nyH := high
    nyL := low
    nyC := close
else if inNY
    nyH := math.max(nyH, high)
    nyL := math.min(nyL, low)
    nyC := close

// ----- classify each session at its end; roll the "last session"; count roles
var float lastSessHi = na
var float lastSessLo = na
var string lastSessName = "—"
var string lastSessPhase = "—"
var int lastSessDir = 0
var float refAsia = na
var float refLon  = na
var float refNY   = na
var string asiaPhase = "—"
var string lonPhase  = "—"
var string nyPhase   = "—"
var int aA = 0
var int aM = 0
var int aD = 0
var int lA = 0
var int lM = 0
var int lD = 0
var int nA = 0
var int nM = 0
var int nD = 0

if newDay
    asiaPhase := "—"
    lonPhase := "—"
    nyPhase := "—"

endAsia = not inAsia and inAsia[1]
endLon  = not inLon  and inLon[1]
endNY   = not inNY   and inNY[1]

if endAsia
    [phA, drA] = f_phase(asiaO, asiaH, asiaL, asiaC, lastSessHi, lastSessLo, refAsia)
    asiaPhase := phA
    aA := aA + (phA == "Accum" ? 1 : 0)
    aM := aM + (phA == "Manip" ? 1 : 0)
    aD := aD + (phA == "Distrib" ? 1 : 0)
    lastSessHi := asiaH
    lastSessLo := asiaL
    lastSessName := "Asia"
    lastSessPhase := phA
    lastSessDir := drA
    refAsia := na(refAsia) ? asiaH - asiaL : refAsia * 0.8 + (asiaH - asiaL) * 0.2
if endLon
    [phL, drL] = f_phase(lonO, lonH, lonL, lonC, lastSessHi, lastSessLo, refLon)
    lonPhase := phL
    lA := lA + (phL == "Accum" ? 1 : 0)
    lM := lM + (phL == "Manip" ? 1 : 0)
    lD := lD + (phL == "Distrib" ? 1 : 0)
    lastSessHi := lonH
    lastSessLo := lonL
    lastSessName := "London"
    lastSessPhase := phL
    lastSessDir := drL
    refLon := na(refLon) ? lonH - lonL : refLon * 0.8 + (lonH - lonL) * 0.2
if endNY
    [phN, drN] = f_phase(nyO, nyH, nyL, nyC, lastSessHi, lastSessLo, refNY)
    nyPhase := phN
    nA := nA + (phN == "Accum" ? 1 : 0)
    nM := nM + (phN == "Manip" ? 1 : 0)
    nD := nD + (phN == "Distrib" ? 1 : 0)
    lastSessHi := nyH
    lastSessLo := nyL
    lastSessName := "NewYork"
    lastSessPhase := phN
    lastSessDir := drN
    refNY := na(refNY) ? nyH - nyL : refNY * 0.8 + (nyH - nyL) * 0.2

expectTxt = lastSessPhase == "Accum" ? "SWEEP likely (manip)" : lastSessPhase == "Manip" ? "DISTRIB " + (lastSessDir == 1 ? "▲ up" : "▼ down") : lastSessPhase == "Distrib" ? "pullback / accum" : "—"

// ----- candlestick trigger ---------------------------------------------------
bodyC = math.abs(close - open)
rngC  = high - low
upWk  = high - math.max(close, open)
dnWk  = math.min(close, open) - low
isDoji  = rngC > 0 and bodyC <= 0.1 * rngC
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullPin = rngC > 0 and dnWk >= wickMult * bodyC and (high - close) <= 0.45 * rngC
bearPin = rngC > 0 and upWk >= wickMult * bodyC and (close - low) <= 0.45 * rngC
bullMar = close > open and bodyC >= 1.0 * atr
bearMar = open > close and bodyC >= 1.0 * atr
bullConf = (bullEng or bullPin or bullMar) and not isDoji
bearConf = (bearEng or bearPin or bearMar) and not isDoji
cndName = isDoji ? "doji" : (bullEng or bearEng) ? "engulf" : (bullPin or bearPin) ? "pin" : (bullMar or bearMar) ? "strong" : "—"

// ----- liquidity sweep (the manipulation, in real time) ----------------------
sweepLoNow = (usePoolSess and f_swLo(lastSessLo)) or (usePoolPD and f_swLo(pdl)) or (usePoolPW and f_swLo(pwl)) or (usePoolAsia and f_swLo(asiaL))
sweepHiNow = (usePoolSess and f_swHi(lastSessHi)) or (usePoolPD and f_swHi(pdh)) or (usePoolPW and f_swHi(pwh)) or (usePoolAsia and f_swHi(asiaH))
swLoName = (usePoolSess and f_swLo(lastSessLo)) ? lastSessName + "·L" : (usePoolPD and f_swLo(pdl)) ? "PDL" : (usePoolPW and f_swLo(pwl)) ? "PWL" : (usePoolAsia and f_swLo(asiaL)) ? "Asia·L" : "—"
swHiName = (usePoolSess and f_swHi(lastSessHi)) ? lastSessName + "·H" : (usePoolPD and f_swHi(pdh)) ? "PDH" : (usePoolPW and f_swHi(pwh)) ? "PWH" : (usePoolAsia and f_swHi(asiaH)) ? "Asia·H" : "—"

// ----- SMT divergence: a correlated market fails to confirm the new extreme ---
smtRefLow  = request.security(smtSym, timeframe.period, low,  lookahead = barmerge.lookahead_off)
smtRefHigh = request.security(smtSym, timeframe.period, high, lookahead = barmerge.lookahead_off)
gLL = low  < ta.lowest(low,  smtLen)[1]
gHH = high > ta.highest(high, smtLen)[1]
rLL = smtRefLow  < ta.lowest(smtRefLow,  smtLen)[1]
rHH = smtRefHigh > ta.highest(smtRefHigh, smtLen)[1]
smtBull = smtCorr == "Positive" ? (gLL and not rLL) : (gLL and not rHH)
smtBear = smtCorr == "Positive" ? (gHH and not rHH) : (gHH and not rLL)

// ============================== STATE MACHINE ================================
var bool  inTrade  = false
var int   dir      = 0
var float entryP   = na
var float slP      = na
var float tpP      = na
var float riskDist = na
var float tradeRR  = na
var int   entryBar = na
var float peakP    = na
var bool  beDone   = false
var int   pendDir  = 0
var float zLvl     = na
var int   pendBar  = na
var int   lastExitBar = na
var int   nT = 0
var int   nW = 0
var float sumR = 0.0
var float grW = 0.0
var float grL = 0.0

cooled = na(lastExitBar) or bar_index - lastExitBar >= cooldownBars

longSig   = false
shortSig  = false
tpHit     = false
slHit     = false
exitEarly = false

// ----- 2-stage retest flow: arm on the sweep, enter on the retest close ------
swpLoPrice = (usePoolSess and f_swLo(lastSessLo)) ? lastSessLo : (usePoolPD and f_swLo(pdl)) ? pdl : (usePoolPW and f_swLo(pwl)) ? pwl : (usePoolAsia and f_swLo(asiaL)) ? asiaL : na
swpHiPrice = (usePoolSess and f_swHi(lastSessHi)) ? lastSessHi : (usePoolPD and f_swHi(pdh)) ? pdh : (usePoolPW and f_swHi(pwh)) ? pwh : (usePoolAsia and f_swHi(asiaH)) ? asiaH : na
strongLo = f_touches(swpLoPrice, srTol * atr, srLook) >= srTouches
strongHi = f_touches(swpHiPrice, srTol * atr, srLook) >= srTouches
armBullNow = sweepLoNow and inSessionOK and (not requireBias or biasBull) and (not requireMom or momBull) and (not requireChoch or chochArmBull) and (not requireSMT or smtBull) and (not useStrongSR or strongLo)
armBearNow = sweepHiNow and inSessionOK and (not requireBias or biasBear) and (not requireMom or momBear) and (not requireChoch or chochArmBear) and (not requireSMT or smtBear) and (not useStrongSR or strongHi)
if armBullNow
    pendDir := 1
    zLvl := swpLoPrice
    pendBar := bar_index
if armBearNow
    pendDir := -1
    zLvl := swpHiPrice
    pendBar := bar_index
if pendDir == 1 and (close < zLvl - retestTol * atr or bar_index - pendBar > retestBars)
    pendDir := 0
if pendDir == -1 and (close > zLvl + retestTol * atr or bar_index - pendBar > retestBars)
    pendDir := 0
retestBull = pendDir == 1 and bar_index > pendBar and low  <= zLvl + retestTol * atr and bullConf
retestBear = pendDir == -1 and bar_index > pendBar and high >= zLvl - retestTol * atr and bearConf

trigBull = entryMode == "Retest zone (plan)" ? retestBull : (sweepLoNow and (not useCandle or bullConf) and inSessionOK and (not requireBias or biasBull) and (not requireMom or momBull) and (not requireChoch or chochArmBull) and (not requireSMT or smtBull) and (not useStrongSR or strongLo))
trigBear = entryMode == "Retest zone (plan)" ? retestBear : (sweepHiNow and (not useCandle or bearConf) and inSessionOK and (not requireBias or biasBear) and (not requireMom or momBear) and (not requireChoch or chochArmBear) and (not requireSMT or smtBear) and (not useStrongSR or strongHi))

if barstate.isconfirmed
    if inTrade
        if tgtMode == "Trail runner"
            peakP := dir == 1 ? math.max(peakP, high) : math.min(peakP, low)
            if not beDone and dir * (close - entryP) >= beR * riskDist
                slP := dir == 1 ? math.max(slP, entryP) : math.min(slP, entryP)
                beDone := true
            if beDone
                float cand = dir == 1 ? peakP - trailAtr * atr : peakP + trailAtr * atr
                slP := dir == 1 ? math.max(slP, cand) : math.min(slP, cand)
        bool  doExit = false
        float exitP  = na
        bool hitS = dir == 1 ? low  <= slP : high >= slP
        bool hitT = dir == 1 ? high >= tpP : low  <= tpP
        if hitS
            exitP := slP
            doExit := true
            slHit := true
        else if hitT
            exitP := tpP
            doExit := true
            tpHit := true
        else if useFailExit and (dir == 1 ? sweepHiNow : sweepLoNow)
            exitP := close
            doExit := true
            exitEarly := true
        else if useTimeStop and tgtMode != "Trail runner" and bar_index - entryBar >= maxBars
            exitP := close
            doExit := true
            exitEarly := true
        if doExit
            float r = dir * (exitP - entryP) / riskDist
            nT := nT + 1
            nW := nW + (r > 0 ? 1 : 0)
            sumR := sumR + r
            grW := grW + (r > 0 ? r : 0.0)
            grL := grL + (r < 0 ? -r : 0.0)
            lastExitBar := bar_index
            inTrade := false
            dir := 0
    if not inTrade and cooled and (trigBull or trigBear)
        dir := trigBull ? 1 : -1
        entryP := close
        float prot = dir == 1 ? (not na(zLvl) ? math.min(zLvl, low) : low) : (not na(zLvl) ? math.max(zLvl, high) : high)
        float rawSL = stopMode == "Fixed $" ? (dir == 1 ? entryP - slDist : entryP + slDist) : stopMode == "Beyond key level" ? (dir == 1 ? prot - slBuf * atr : prot + slBuf * atr) : (dir == 1 ? low - slBuf * atr : high + slBuf * atr)
        float floorSL = dir == 1 ? entryP - minStopAtr * atr : entryP + minStopAtr * atr
        rawSL := dir == 1 ? math.min(rawSL, floorSL) : math.max(rawSL, floorSL)
        float minR = 0.2 * atr
        if dir == 1 and rawSL > entryP - minR
            rawSL := entryP - minR
        if dir == -1 and rawSL < entryP + minR
            rawSL := entryP + minR
        slP := rawSL
        riskDist := math.abs(entryP - slP)
        float tp = entryP + dir * rr * riskDist
        if tgtMode == "Next key level"
            float t = na
            if dir == 1
                if not na(pdh) and pdh > entryP + riskDist
                    t := pdh
                if not na(pwh) and pwh > entryP + riskDist and (na(t) or pwh < t)
                    t := pwh
                if not na(lastSessHi) and lastSessHi > entryP + riskDist and (na(t) or lastSessHi < t)
                    t := lastSessHi
                if not na(asiaH) and asiaH > entryP + riskDist and (na(t) or asiaH < t)
                    t := asiaH
            else
                if not na(pdl) and pdl < entryP - riskDist
                    t := pdl
                if not na(pwl) and pwl < entryP - riskDist and (na(t) or pwl > t)
                    t := pwl
                if not na(lastSessLo) and lastSessLo < entryP - riskDist and (na(t) or lastSessLo > t)
                    t := lastSessLo
                if not na(asiaL) and asiaL < entryP - riskDist and (na(t) or asiaL > t)
                    t := asiaL
            tp := not na(t) ? t : entryP + dir * rr * riskDist
        else if tgtMode == "Furthest pool"
            float t = na
            if dir == 1
                if not na(pdh) and pdh > entryP
                    t := pdh
                if not na(pwh) and pwh > entryP and (na(t) or pwh > t)
                    t := pwh
                if not na(lastSessHi) and lastSessHi > entryP and (na(t) or lastSessHi > t)
                    t := lastSessHi
            else
                if not na(pdl) and pdl < entryP
                    t := pdl
                if not na(pwl) and pwl < entryP and (na(t) or pwl < t)
                    t := pwl
                if not na(lastSessLo) and lastSessLo < entryP and (na(t) or lastSessLo < t)
                    t := lastSessLo
            tp := (not na(t) and dir * (t - entryP) >= riskDist) ? t : entryP + dir * rr * riskDist
        else if tgtMode == "Trail runner"
            tp := entryP + dir * maxRRcap * riskDist
        tpP := tp
        tradeRR := math.abs(tpP - entryP) / riskDist
        entryBar := bar_index
        peakP := entryP
        beDone := false
        inTrade := true
        longSig := trigBull
        shortSig := trigBear
        pendDir := 0

// ============================== STATS ========================================
winRate = nT > 0 ? nW / nT * 100 : 0.0
avgR    = nT > 0 ? sumR / nT : 0.0
pf      = grL > 0 ? grW / grL : (grW > 0 ? 999.0 : 0.0)

// ============================== DRAWING ======================================
plot(drawLevels and usePoolPD ? pdh : na, "PDH", color.new(color.red, 40),    1, plot.style_linebr)
plot(drawLevels and usePoolPD ? pdl : na, "PDL", color.new(color.green, 40),  1, plot.style_linebr)
plot(drawLevels and usePoolPW ? pwh : na, "PWH", color.new(color.orange, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolPW ? pwl : na, "PWL", color.new(color.orange, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolAsia ? asiaH : na, "Asia H", color.new(color.aqua, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolAsia ? asiaL : na, "Asia L", color.new(color.aqua, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolSess ? lastSessHi : na, "Last H", color.new(color.gray, 20), 1, plot.style_linebr)
plot(drawLevels and usePoolSess ? lastSessLo : na, "Last L", color.new(color.gray, 20), 1, plot.style_linebr)

// HTF trend candle coloring (green up / red down)
barcolor(colorHTF ? (htfcUp ? color.new(color.green, 25) : htfcDn ? color.new(color.red, 25) : na) : na)

// session shading — morning / noon per session
inAsiaAM = not na(time(timeframe.period, asiaAM, "GMT+0"))
inAsiaPM = not na(time(timeframe.period, asiaPM, "GMT+0"))
inLonAM  = not na(time(timeframe.period, lonAM,  "GMT+0"))
inLonPM  = not na(time(timeframe.period, lonPM,  "GMT+0"))
inNyAM   = not na(time(timeframe.period, nyAM,   "GMT+0"))
inNyPM   = not na(time(timeframe.period, nyPM,   "GMT+0"))
bgcolor(drawSess and inAsiaAM ? color.new(color.blue,   93) : na, title = "Asia morning")
bgcolor(drawSess and inAsiaPM ? color.new(color.blue,   88) : na, title = "Asia noon")
bgcolor(drawSess and inLonAM  ? color.new(color.green,  93) : na, title = "London morning")
bgcolor(drawSess and inLonPM  ? color.new(color.green,  88) : na, title = "London noon")
bgcolor(drawSess and inNyAM   ? color.new(color.orange, 93) : na, title = "New York morning")
bgcolor(drawSess and inNyPM   ? color.new(color.orange, 88) : na, title = "New York noon")

var box   bxSL    = na
var box   bxTP    = na
var line  lnEnt   = na
var label lbBadge = na
var label lbSL    = na
var label lbTP    = na
if longSig or shortSig
    if not na(bxSL)
        box.delete(bxSL)
    if not na(bxTP)
        box.delete(bxTP)
    if not na(lnEnt)
        line.delete(lnEnt)
    if not na(lbBadge)
        label.delete(lbBadge)
    if not na(lbSL)
        label.delete(lbSL)
    if not na(lbTP)
        label.delete(lbTP)
    int xR = bar_index + 5
    bxSL := box.new(bar_index, math.max(entryP, slP), xR, math.min(entryP, slP), border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 85))
    bxTP := box.new(bar_index, math.max(entryP, tpP), xR, math.min(entryP, tpP), border_color = color.new(color.green, 50), bgcolor = color.new(color.green, 85))
    lnEnt := line.new(bar_index, entryP, xR, entryP, color = color.new(color.blue, 0), width = 2, style = line.style_dashed)
    lbBadge := label.new(bar_index, entryP, (dir == 1 ? "BUY " : "SELL ") + (tgtMode == "Trail runner" ? "⛓ run" : "1:" + str.tostring(tradeRR, "#.#")), style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
    lbSL := label.new(xR, slP, "SL " + str.tostring(slP, "#.##"), style = label.style_label_left, color = color.new(color.red, 10),   textcolor = color.white, size = size.small)
    lbTP := label.new(xR, tpP, "TP " + str.tostring(tpP, "#.##"), style = label.style_label_left, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
else if inTrade and not na(bxSL)
    int xR = bar_index + 5
    box.set_right(bxSL, xR)
    box.set_right(bxTP, xR)
    box.set_top(bxSL, math.max(entryP, slP))
    box.set_bottom(bxSL, math.min(entryP, slP))
    line.set_x2(lnEnt, xR)
    label.set_xy(lbSL, xR, slP)
    label.set_text(lbSL, "SL " + str.tostring(slP, "#.##"))
    label.set_x(lbTP, xR)

plotshape(sweepLoNow, "Swept low",  shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size = size.tiny)
plotshape(sweepHiNow, "Swept high", shape.triangledown, location.abovebar, color.new(color.maroon, 0), size = size.tiny)
plotshape(longSig,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(shortSig, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)
plotshape(tpHit,    "TP",   shape.circle, location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(slHit,    "SL",   shape.xcross, location.abovebar, color.new(color.red, 0),   size = size.tiny)
plotshape(exitEarly,"Exit", shape.square, location.abovebar, color.new(color.gray, 0),  size = size.tiny)

// ============================== DASHBOARD ====================================
f_pos() => dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(f_pos(), 2, 18, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
if showDash and barstate.islast
    cW = color.white
    sessTxt = inNY ? "New York" : inLon ? "London" : inAsia ? "Asia" : "—"
    liveHint = (sweepLoNow or sweepHiNow) ? "⚡ sweeping" : inSession ? "forming" : "—"
    expC = lastSessPhase == "Manip" ? color.new(color.green, 20) : lastSessPhase == "Accum" ? color.new(color.orange, 20) : color.new(color.gray, 30)
    okEntry = trigBull or trigBear
    fStr = (requireBias ? "B" + f_chk(biasBull or biasBear) + " " : "") + (requireMom ? "M" + f_chk(momBull or momBear) + " " : "") + (requireChoch ? "C" + f_chk(chochArmBull or chochArmBear) + " " : "") + (requireSMT ? "SMT" + f_chk(smtBull or smtBear) + " " : "") + (useStrongSR ? "SR" + f_chk(strongLo or strongHi) : "")
    fStr := fStr == "" ? "soft (none)" : fStr
    verdict = trigBull ? "⚑ BUY" : trigBear ? "⚑ SELL" : inTrade ? (dir == 1 ? "● LONG" : "● SHORT") : pendDir != 0 ? (pendDir == 1 ? "⌛ wait retest ▲" : "⌛ wait retest ▼") : "WAIT"
    verdictC= trigBull ? color.new(color.green, 0) : trigBear ? color.new(color.red, 0) : inTrade ? color.new(color.blue, 10) : pendDir != 0 ? color.new(color.orange, 20) : color.new(color.gray, 30)
    table.cell(dash, 0, 0, "APEX SESSION SMC (adaptive)", text_color = cW, bgcolor = color.new(color.blue, 10), text_size = size.small)
    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 1, "Session", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 1, sessTxt + " · " + liveHint, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 2, "Phases today", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 2, "A:" + asiaPhase + " L:" + lonPhase + " N:" + nyPhase, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 3, "Last session", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 3, lastSessName + " = " + lastSessPhase, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 4, "EXPECT next", text_color = cW, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 4, expectTxt, text_color = cW, bgcolor = expC, text_size = size.small)
    table.cell(dash, 0, 5, "— ENTRY —", text_color = cW, bgcolor = color.new(color.gray, 60), text_size = size.small)
    table.merge_cells(dash, 0, 5, 1, 5)
    table.cell(dash, 0, 6, "Pool swept", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 6, (sweepLoNow or sweepHiNow ? "✓ " : "✗ ") + (sweepLoNow ? swLoName : sweepHiNow ? swHiName : ""), text_color = (sweepLoNow or sweepHiNow) ? color.green : color.red, text_size = size.small)
    table.cell(dash, 0, 7, "Candle", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 7, f_chk((bullConf or bearConf) and not isDoji) + " " + cndName, text_color = (bullConf or bearConf) ? color.green : color.red, text_size = size.small)
    table.cell(dash, 0, 8, "Filters", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 8, fStr, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 9, "VERDICT", text_color = cW, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 9, verdict, text_color = cW, bgcolor = verdictC, text_size = size.small)
    table.cell(dash, 0, 10, "Entry", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 10, inTrade ? str.tostring(entryP, "#.##") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 11, "TP / SL", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 11, inTrade ? str.tostring(tpP, "#.#") + " / " + str.tostring(slP, "#.#") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 12, "Risk / RR", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 12, inTrade ? str.tostring(riskDist, "#.#") + " / 1:" + str.tostring(tradeRR, "#.#") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 13, "— SESSION ROLES (A/M/D) —", text_color = cW, bgcolor = color.new(color.gray, 60), text_size = size.small)
    table.merge_cells(dash, 0, 13, 1, 13)
    table.cell(dash, 0, 14, "Asia", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 14, str.tostring(aA) + " / " + str.tostring(aM) + " / " + str.tostring(aD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 15, "London", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 15, str.tostring(lA) + " / " + str.tostring(lM) + " / " + str.tostring(lD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 16, "New York", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 16, str.tostring(nA) + " / " + str.tostring(nM) + " / " + str.tostring(nD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 17, "Trades W% / PF", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 17, str.tostring(nT) + " " + str.tostring(winRate, "#") + "% / " + str.tostring(pf, "#.##"), text_color = pf >= 1 ? color.green : color.red, text_size = size.small)

// ============================== ALERTS =======================================
if longSig
    alert("APEX SMC BUY " + syminfo.ticker + " @ " + str.tostring(entryP, "#.##") + " | SL " + str.tostring(slP, "#.##") + " | TP " + str.tostring(tpP, "#.##") + " | 1:" + str.tostring(tradeRR, "#.#"), alert.freq_once_per_bar_close)
if shortSig
    alert("APEX SMC SELL " + syminfo.ticker + " @ " + str.tostring(entryP, "#.##") + " | SL " + str.tostring(slP, "#.##") + " | TP " + str.tostring(tpP, "#.##") + " | 1:" + str.tostring(tradeRR, "#.#"), alert.freq_once_per_bar_close)
alertcondition(longSig,  "SMC Long Entry",  "Apex SMC BUY")
alertcondition(shortSig, "SMC Short Entry", "Apex SMC SELL")
