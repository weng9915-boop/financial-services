//@version=6
// =============================================================================
//  APEX SESSION SMC  —  XAUUSD  (ADAPTIVE phases: detect A/M/D, don't assume it)
// -----------------------------------------------------------------------------
//  Phases are NOT hard-wired to sessions. Any session can accumulate, manipulate
//  or distribute. This tool:
//    • CLASSIFIES every completed session live — Accumulation (ranged),
//      Manipulation (swept a prior pool and reversed), or Distribution (expanded
//      directionally).
//    • COUNTS which session tends to play which role over all history (the
//      built-in "which session does what" backtest).
//    • PROJECTS the next session: after accumulation expect a sweep; after a
//      manipulation expect distribution in the reversal direction; after
//      distribution expect a pullback.
//
//  ENTRY (loose enough to actually fire): a LIQUIDITY POOL is swept and reclaimed
//  (the manipulation, happening now) + a confirming CANDLESTICK is the trigger,
//  scored (not hard-gated) for quality. HTF bias / CHoCH are OPTIONAL filters
//  (off by default) you add to tighten.
//
//  THIS VERSION adds ONE thing on top of the base script: a DEEPER-POOL
//  PULLBACK REQUIREMENT (opt-in, ON by default). Diagnosed failure mode: a
//  valid setup gets its SL raided by a DIFFERENT, deeper resting pool the
//  naive stop never accounted for (e.g. an Asia low from hours earlier,
//  sitting below whatever shallower level actually triggered entry) — then
//  price reverses in the original direction anyway, just without the trade
//  in it. Fixed at the source, not after the fact: at the moment of the
//  sweep, it checks the same session/PD/PW/Asia pools for one sitting beyond
//  the swept level within a search radius. If found, the retest itself must
//  reach THAT deeper level before the setup can fire, and the stop anchors
//  to it from the start — no separate widening step, and no skip mode either
//  (a setup that needs the deeper level either gets it within the normal
//  retest window or expires, same as any other setup). See the "④ Execution"
//  group. Net effect: fewer trades, but by the time one fires, the market has
//  usually already done most of the raiding it was going to do.
//
//  LOCKED entry (now deeper-pullback aware) / SL (beyond the sweep, same
//  deeper anchor) / TP (fraction of the way to the next key level, not the
//  full level). Non-repaint on bar close. Not financial advice.
// =============================================================================

indicator("Apex Session SMC + Deeper-Pool Guard [XAUUSD]", "ApexSMC-DPG", overlay = true,
     max_boxes_count = 200, max_lines_count = 200, max_labels_count = 200, max_bars_back = 500)

// TradingView/LuxAlgo-native palette (matches the reference graphic) — replaces
// Pine's brighter built-in colBull/colBear everywhere below, same up/down
// meaning, more muted/professional hue. Session-identity colors (blue/green/
// orange for Asia/London/NY) are untouched — that's identity, not direction.
color colBull = #089981
color colBear = #F23645
// Brighter accent pair reserved for High-Probability-Zone order blocks only
// (obScore > 80) — same bull/red-family meaning, just a hotter shade to mark
// the elevated tier. Matches the LuxAlgo MSB & OB Toolkit's HPZ convention.
color HPZ_BULL = #1de9b6
color HPZ_BEAR = #ff5252

// ============================== HELPERS ======================================
f_swLo(float p) => not na(p) and close[1] >= p and low  < p and close > p   // was above, raided below, reclaimed
f_swHi(float p) => not na(p) and close[1] <= p and high > p and close < p   // was below, raided above, reclaimed
f_phase(float o, float h, float l, float c, float pHi, float pLo, float refR, float expMult, float dirMin) =>
    float rng = h - l
    bool swHi = not na(pHi) and h > pHi and c < pHi
    bool swLo = not na(pLo) and l < pLo and c > pLo
    bool manip = swHi or swLo
    bool directional = rng > 0 and math.abs(c - o) > dirMin * rng
    bool big = na(refR) or rng > expMult * refR
    string ph = manip ? "Manip" : (big and directional) ? "Distrib" : "Accum"
    int dr = swHi ? -1 : swLo ? 1 : (c > o ? 1 : -1)
    [ph, dr]
f_chk(bool b) => b ? "✓" : "✗"
f_touches(float lvl, float tol, int look) =>
    int c = 0
    if not na(lvl)
        for i = 0 to look - 1
            if math.abs(high[i] - lvl) <= tol or math.abs(low[i] - lvl) <= tol
                c := c + 1
    c
f_nextPool(int d, float px, float _pdh, float _pdl, float _pwh, float _pwl, float _lastHi, float _lastLo, string _lastNm, float _asiaH, float _asiaL) =>
    float t = na
    string nm = "—"
    if d == 1
        if not na(_pdh) and _pdh > px
            t := _pdh
            nm := "PDH"
        if not na(_pwh) and _pwh > px and (na(t) or _pwh < t)
            t := _pwh
            nm := "PWH"
        if not na(_lastHi) and _lastHi > px and (na(t) or _lastHi < t)
            t := _lastHi
            nm := _lastNm + " H"
        if not na(_asiaH) and _asiaH > px and (na(t) or _asiaH < t)
            t := _asiaH
            nm := "Asia H"
    else
        if not na(_pdl) and _pdl < px
            t := _pdl
            nm := "PDL"
        if not na(_pwl) and _pwl < px and (na(t) or _pwl > t)
            t := _pwl
            nm := "PWL"
        if not na(_lastLo) and _lastLo < px and (na(t) or _lastLo > t)
            t := _lastLo
            nm := _lastNm + " L"
        if not na(_asiaL) and _asiaL < px and (na(t) or _asiaL > t)
            t := _asiaL
            nm := "Asia L"
    [t, nm]
// ----- deeper-pool pullback requirement: is there a resting pool BEYOND the
// level that just got swept, still un-taken? If so, that's a magnet the
// market can still reach for before reversing — the exact mechanism that ran
// a good read's SL out from under it. Searched from the SWEPT LEVEL itself
// (not from an already-built stop — that was v1's mistake, it rarely found
// anything because the search anchor was already too shallow). Mirrors the
// same low/high-side pools used to arm the OPPOSITE-direction setup
// (session/PD/PW/Asia), bounded by maxDist so this can't wander off chasing a
// level that was never realistically in play. Explicit params (not closures)
// to match this file's existing helper convention (see f_nextPool above).
f_deeperPool(int d, float refLvl, float maxDist, float _pdh, float _pdl, float _pwh, float _pwl, float _lastHi, float _lastLo, float _asiaH, float _asiaL, float _pmh, float _pml) =>
    float best = na
    if d == 1
        if not na(_asiaL) and _asiaL <= refLvl and refLvl - _asiaL <= maxDist
            best := na(best) ? _asiaL : math.min(best, _asiaL)
        if not na(_pdl) and _pdl <= refLvl and refLvl - _pdl <= maxDist
            best := na(best) ? _pdl : math.min(best, _pdl)
        if not na(_pwl) and _pwl <= refLvl and refLvl - _pwl <= maxDist
            best := na(best) ? _pwl : math.min(best, _pwl)
        if not na(_lastLo) and _lastLo <= refLvl and refLvl - _lastLo <= maxDist
            best := na(best) ? _lastLo : math.min(best, _lastLo)
        if not na(_pml) and _pml <= refLvl and refLvl - _pml <= maxDist
            best := na(best) ? _pml : math.min(best, _pml)
    else
        if not na(_asiaH) and _asiaH >= refLvl and _asiaH - refLvl <= maxDist
            best := na(best) ? _asiaH : math.max(best, _asiaH)
        if not na(_pdh) and _pdh >= refLvl and _pdh - refLvl <= maxDist
            best := na(best) ? _pdh : math.max(best, _pdh)
        if not na(_pwh) and _pwh >= refLvl and _pwh - refLvl <= maxDist
            best := na(best) ? _pwh : math.max(best, _pwh)
        if not na(_lastHi) and _lastHi >= refLvl and _lastHi - refLvl <= maxDist
            best := na(best) ? _lastHi : math.max(best, _lastHi)
        if not na(_pmh) and _pmh >= refLvl and _pmh - refLvl <= maxDist
            best := na(best) ? _pmh : math.max(best, _pmh)
    best
f_lvlTxt(string nm, int touches, int strongAt) =>
    nm + (touches > 0 ? " ×" + str.tostring(touches) : "") + (touches >= strongAt ? " ✓" : "")
f_mtfArrow(int t) => t == 1 ? "▲" : t == -1 ? "▼" : "•"
f_2d(int v) => (v < 10 ? "0" : "") + str.tostring(v)
f_overlapsAny(array<box> arr, float top, float bot) =>
    bool ov = false
    if arr.size() > 0 and not na(top) and not na(bot)
        for i = 0 to arr.size() - 1
            box b = arr.get(i)
            if math.min(top, box.get_top(b)) >= math.max(bot, box.get_bottom(b))
                ov := true
    ov

// ============================== ① SESSIONS ===================================
gS = "① Sessions"
sessTz    = input.string("GMT+0", "Session timezone", group = gS, tooltip = "All session/killzone windows below are read in this timezone. Default GMT+0 keeps the shipped windows as-is, but ICT killzones are anchored to NEW YORK time — set this to America/New_York and re-enter the windows in NY time once, and daylight-saving shifts are then handled automatically instead of your killzone silently drifting an hour twice a year.")
asiaSess  = input.session("2300-0700", "Asia window", group = gS)
lonSess   = input.session("0700-1200", "London window", group = gS)
nySess    = input.session("1200-2100", "New York window", group = gS)
lonKZ     = input.session("0700-1000", "London killzone", group = gS, tooltip = "The actual ICT London killzone (narrower than the full London window above). Used only when 'Trade in' = Kill zones only.")
nyKZ      = input.session("1200-1500", "New York AM killzone", group = gS, tooltip = "The actual ICT NY AM killzone, 07:00-10:00 EST (narrower than the full NY window above). Used only when 'Trade in' = Kill zones only.")
sessMode  = input.string("Any", "Trade in", options = ["Any","Kill zones only"], group = gS, tooltip = "Any (default): all sessions are tradeable — killzone timing is rewarded in the CONFLUENCE SCORE (+2 in KZ, +1 in session) instead of hard-blocking everything else; the backtest comparison showed the hard killzone gate cut too much opportunity for the quality it added. Kill zones only: hard-gate to the London/NY killzone windows.")
useSB = input.bool(true, "Silver Bullet windows (+1 score)", group = gS, tooltip = "ICT's three fixed one-hour algorithm windows: 3-4am, 10-11am, 2-3pm NEW YORK time. Entries landing inside one earn +1 confluence. Defaults below are GMT for summer (EDT) — if you set the session timezone to America/New_York, change these to 0300-0400 / 1000-1100 / 1400-1500 and they self-adjust for DST.")
sbLon = input.session("0700-0800", "  SB London (3-4am NY)", group = gS)
sbAM  = input.session("1400-1500", "  SB NY AM (10-11am NY)", group = gS)
sbPM  = input.session("1800-1900", "  SB NY PM (2-3pm NY)", group = gS)

// ============================== ①b TRADE-DAY FILTERS =========================
gT = "①b Trade-day filters"
avoidMonday = input.bool(false, "Skip Mondays (analysis / trap day)", group = gT, tooltip = "Many desks treat Monday as range-building: the week's manipulation leg often forms Mon-Tue and the true weekly expansion follows. Off by default — test it, don't assume.")
avoidNFP    = input.bool(true, "Skip NFP day (first Friday of month — auto)", group = gT, tooltip = "Auto-detected, no date entry needed. NFP whipsaw on gold routinely sweeps BOTH sides of the range before picking a direction — exactly the environment where this system's stops get run.")
newsDates   = input.string("", "Extra no-trade dates (YYYY-MM-DD, comma-separated)", group = gT, tooltip = "FOMC / CPI / unemployment-claims days can't be derived from price data inside Pine, so paste them for the weeks ahead, e.g. 2026-07-29,2026-08-12. The whole day is stood aside — no arming, no entries.")

// ============================== ② PHASE DETECTION ============================
gF = "② Phase detection"
expandMult = input.float(1.2, "Distribution range ≥ avg ×", minval = 1.0, step = 0.1, group = gF, tooltip = "A session counts as Distribution (expansion) when its range exceeds this × the rolling average session range.")
dirThresh  = input.float(0.6, "Directional body ≥ range ×", minval = 0.1, maxval = 1.0, step = 0.05, group = gF)

// ============================== ③ ENTRY ======================================
gE = "③ Entry — confirm → retest → close (retest is the ONLY entry path, no instant fills)"
usePoolSess = input.bool(true, "Pool: last completed session H/L", group = gE)
usePoolPD   = input.bool(true, "Pool: prev day H/L", group = gE)
usePoolPW   = input.bool(true, "Pool: prev week H/L", group = gE)
usePoolAsia = input.bool(true, "Pool: today's Asia H/L", group = gE)
usePoolPM   = input.bool(true, "Pool: prev month H/L", group = gE, tooltip = "The most major key level this system tracks — a monthly swing is a far heavier magnet than a session or even a weekly one. Scored in the same 'major pool' tier as PD/PW/4H-CRT.")
usePoolCRT  = input.bool(false, "Pool: prior 1H / 4H candle H/L (CRT)", group = gE, tooltip = "Candle Range Theory at candle scale: the PREVIOUS 1-hour / 4-hour candle's high/low. OFF by default after backtesting: prior-1H levels get raided constantly on LTF gold, flooding the system with noise arms — and (worse) they were triggering the opposite-sweep fail-exit on healthy winners. Even when enabled, CRT raids no longer trigger the fail-exit. 4H sweep = major pool (+2 score), 1H = minor (+1).")
usePoolEQ   = input.bool(false, "Pool: Equal Highs/Lows (EQH/EQL)", group = gE, tooltip = "Two major swing highs (or lows) within a tight tolerance = a real EQH/EQL pool. OFF by default: in the best-performing configuration this pool was effectively inactive (a legacy bug quietly disabled it), and activating it added minor-swing noise trades. Enable deliberately and re-test — don't assume.")
eqTol       = input.float(0.25, "  EQH/EQL tolerance × ATR", minval = 0.05, step = 0.05, group = gE)
confirmModel = input.string("Classic: swept-level retest", "Confirmation model", options = ["Strict ICT: displacement → FVG retest", "Classic: swept-level retest"], group = gE, tooltip = "Classic (default): price retests the swept level with a confirming candle — fires often enough to matter; quality is then enforced by the CONFLUENCE SCORE below, where displacement-FVG and CISD/MSS earn +2 each instead of being hard requirements. Strict ICT: the full manipulation → displacement → FVG-retrace sequence as a hard requirement — very selective (backtests showed ~2 trades/month).")
useCandle   = input.bool(true, "Require a confirming candlestick", group = gE, tooltip = "The trigger: entry bar must be engulfing / pin-rejection / strong-body, not a doji.")
wickMult    = input.float(2.0, "  Pin wick ≥ body ×", minval = 0.5, step = 0.1, group = gE)
requireBias = input.bool(false, "Filter: HTF EMA trend must agree", group = gE, tooltip = "Coarse proxy only — close vs. 50-EMA on the HTF. This is NOT true ICT bias (which comes from HTF liquidity draw / prior-day range / structure), just a loose directional filter. Off by default.")
biasTF      = input.timeframe("60", "  HTF timeframe", group = gE)
requireChoch= input.bool(false, "Filter: CHoCH must confirm", group = gE)
pivLen      = input.int(3, "  CHoCH swing sensitivity", minval = 1, group = gE)
retestBars = input.int(20, "  Setup valid for (bars)", minval = 1, group = gE, tooltip = "Total window from the sweep for the whole sequence to complete (strict: displacement + structure shift + retrace into the FVG; classic: retest of the level). Expired = no trade, no chasing. 20 matched the best backtest; 30 let stale setups fill late.")
retestTol  = input.float(0.5, "  Retest tolerance × ATR", minval = 0.05, step = 0.05, group = gE)

// ============================== EXTRA CONFIRMATIONS (optional) ===============
gX = "Extra confirmations (optional)"
requireSMT = input.bool(false, "Require SMT divergence", group = gX, tooltip = "Smart-Money Technique: take the sweep only if a CORRELATED market fails to confirm the new extreme — divergence = a stop-raid (manipulation), not real flow.")
smtSym  = input.symbol("TVC:DXY", "  Correlated symbol", group = gX, tooltip = "Default = DXY (Dollar Index), inverse to gold — the standard ICT SMT pairing for XAUUSD. Swap to OANDA:XAGUSD (Positive) if your feed's DXY is unreliable.")
smtCorr = input.string("Inverse", "  Correlation to gold", options = ["Positive","Inverse"], group = gX, tooltip = "Inverse = moves AGAINST gold (DXY / USD) — use with DXY. Positive = moves WITH gold (silver XAGUSD) — use with XAGUSD.")
smtLen  = input.int(10, "  SMT swing lookback", minval = 2, group = gX)
useStrongSR = input.bool(false, "Require strong (tested) level", group = gX, tooltip = "Only trade a swept level that has been TOUCHED several times recently — a confirmed S/R, not a random level a single raid manufactured.")
srTouches = input.int(2, "  Min touches", minval = 1, group = gX)
srLook    = input.int(50, "  Touch lookback (bars)", minval = 5, maxval = 480, group = gX)
srTol     = input.float(0.4, "  Touch tolerance × ATR", minval = 0.05, step = 0.05, group = gX)
requirePress = input.bool(false, "Require net pressure agrees", group = gX, tooltip = "Only take longs when up-displacement > down-displacement over the look-back (buyers pushing harder), and vice-versa. Your 'more seller / more demand' read, as a hard filter.")
requireOTE   = input.bool(false, "Require entry within OTE (61.8-78.6% fib) zone", group = gX, tooltip = "Optimal Trade Entry — the classic ICT 'golden ratio' pullback zone. Off as a HARD gate (the backtest comparison showed it cut too many setups); it still earns +1 in the confluence score when present.")
majorSweepThresh = input.float(70, "Major sweep = volume percentile ≥", minval = 50, maxval = 99, group = gX, tooltip = "Classifies the sweep bar's volume against its own percentile rank over the last 100 bars, instead of a flat multiple-of-average threshold — a real 'was this a genuine stop-hunt or just quiet drift through the level' read. Feeds the confluence score in place of the old flat-multiple volume-climax check; shown on the dashboard as MAJOR/minor next to the swept pool.")

// ============================== CONFLUENCE SCORE =============================
gC = "③b Confluence score — ONE dial for frequency ↔ quality"
minScore = input.int(3, "Min score to take a trade (0 = off)", minval = 0, maxval = 21, group = gC, tooltip = "Every pending setup is scored instead of hard-gated. AT THE SWEEP: pool importance (PD/PW/4H-CRT +2, session/Asia/1H/EQ +1) · phase expectation aligned +1 · SMT divergence +1 · OTE zone +1 · RSI divergence +1 · volume climax +1 · swept OUTSIDE the value area (VWAP ±1σ) +1 · daily draw-on-liquidity still available in trade direction +1. AFTER THE SWEEP: displacement FVG +2 · CISD/MSS shift +2. AT ENTRY: killzone +2 / in-session +1 · Silver Bullet window +1 · net pressure +1 · correct side of VWAP +1 · 1H bias agrees +1 · MTF majority (≥3 of 5) +1 · unicorn: entry zone overlaps a breaker +1. Max 21. LESSON FROM TESTING: 7 over-trimmed (10 trades, 50% WR vs 12 at 83% ungated). Default 3 = keep nearly everything, shave only the emptiest setups. Test 0 (reproduce baseline) → 3 → 5, one step at a time, 30+ trades each before raising.")

// ============================== ④ EXECUTION ==================================
gR = "④ Execution — locked levels"
atrLen   = input.int(14, "ATR length", minval = 1, group = gR)
stopMode = input.string("Beyond key level", "Stop placement", options = ["Beyond key level","Beyond sweep + ATR"], group = gR, tooltip = "Beyond key level = SL sits just past the swept/retested LEVEL (structure-based, not a ratio) — moves with price as the levels do.")
slBuf    = input.float(0.3, "  Sweep buffer × ATR", minval = 0, step = 0.1, group = gR)
minStopAtr = input.float(0.8, "  Min stop × ATR (no micro-stops)", minval = 0, step = 0.1, group = gR, tooltip = "Floor on stop distance so a tiny sweep wick doesn't make a micro-stop that gets wicked out and a too-small trade. Wider stop = a touch lower RR but survivable.")
slBeyondSwing = input.bool(true, "  SL beyond recent swing (survive the sweep)", group = gR, tooltip = "IMPORTANT: a stop sitting AT a key level is exactly where liquidity rests, so it gets swept. This pushes the SL past the recent swing extreme (past the stop-hunt zone). Wider stop, lower RR, but you don't get wicked out right before the move.")
slSwingLook = input.int(10, "    Swing look-back (bars)", minval = 2, group = gR)
useDeeperGuard = input.bool(true, "Require retest to reach a deeper untaken pool first", group = gR, tooltip = "THE FIX for a specific diagnosed failure, v2: a valid setup's SL got raided by a DIFFERENT, deeper resting pool the naive stop never accounted for (an Asia low from hours earlier, sitting below whatever shallower level actually triggered entry) — price reversed correctly anyway, just without the trade in it. v1 (widen the stop after the fact) rarely found anything, because it only searched near the ALREADY-BUILT shallow stop. This version fixes it at the source: at the moment of the sweep, it checks the same session/PD/PW/Asia pools for one sitting beyond the swept level within the search radius below. If found, BOTH the retest requirement and the stop anchor shift to that deeper level — the setup won't fire until price actually pulls back that far, and the stop sits just beyond the real level from the start, not bolted on after. Net effect: fewer trades, but the raid the market was going to run has mostly already happened by the time you're in, and the SL follows real structure instead of a shallow proxy for it. No skip mode — a setup that needs the deeper level either gets it or expires within the normal retest window, same as any other setup. Default ON; toggle off to A/B against the untouched retest — 30+ trades each before trusting either.")
deeperGuardAtr = input.float(3.0, "    Search radius × ATR beyond the swept level", minval = 0.5, step = 0.5, group = gR, tooltip = "How far beyond the swept level to look for a deeper, still-untaken pool. Too narrow misses the Asia-low-style case (it was hours old, well outside a tight search); too wide starts requiring pullbacks to levels that were never realistically in play, starving the setup of valid entries. 3×ATR is a starting point — tune with evidence, one step at a time.")
tpKeyLevelPct = input.float(0.8, "TP: % of distance to next key level", minval = 0.5, maxval = 1.0, step = 0.05, group = gR, tooltip = "TP at 80% of the distance to the nearest opposing key level (PDH/PDL/PWH/PWL/session H-L/Asia H-L) — not the full level. Banks before price has to fight through the fresh liquidity or newly formed level sitting right at the target.")
minRRfloor = input.float(0.8, "  Min RR at TP (level must be far enough)", minval = 0.5, step = 0.25, group = gR, tooltip = "A key level only qualifies as a target when taking the % above of the way there still pays at least this many R. Default 0.8 with 80% TP reproduces the proven 'nearest level at least 1R away' selection — the quick nearest-magnet banks are where the win rate lives. Raising this to 1.5 in testing pushed targets farther and dropped the win rate from ~83% to ~50%; raise only with evidence.")
requireLevelTP = input.bool(true, "  No key-level target = no trade", group = gR, tooltip = "Disciplined default: if no opposing key level sits far enough away to pay the minimum RR, the setup is skipped entirely — no structural target, no trade. Turn off to fall back to the fixed RR below instead.")
rr       = input.float(3.0, "  Fallback Reward:Risk (only if the skip above is off)", minval = 0.5, step = 0.5, group = gR)
cooldownBars = input.int(10, "Cooldown after a trade (bars)", minval = 0, group = gR)
useFailExit  = input.bool(true, "Cut on opposite sweep", group = gR)
useTimeStop  = input.bool(true, "Time stop", group = gR)
maxBars      = input.int(40, "  Max bars in trade", minval = 1, group = gR)

// ============================== ⑤ DISPLAY ====================================
gD = "⑤ Display"
showDash = input.bool(true, "Show dashboard", group = gD)
dashPos  = input.string("Top Right", "Position", options = ["Top Right","Top Left","Bottom Right","Bottom Left"], group = gD)
drawLevels = input.bool(true, "Draw key levels / pools", group = gD)
candleColorMode = input.string("HTF Trend", "Color candles by", options = ["HTF Trend", "Volume Pressure", "None"], group = gD, tooltip = "HTF Trend: green when the higher timeframe is up, red when down (constant bias read). Volume Pressure: green/red only on HIGH relative-volume bars in that direction (order-flow-ish; tick volume caveat applies on most gold feeds). None: leave candles alone. Only one mode drives the candles at a time so colors never conflict.")
htfColorTF = input.timeframe("60", "  HTF for candle color", group = gD)
volColorMult = input.float(1.5, "  Volume Pressure: min rel-volume ×", minval = 0.5, step = 0.1, group = gD)
showOB     = input.bool(true, "Draw order blocks (auto-delete on invalidation)", group = gD)
obMaxKeep  = input.int(15, "  Max order blocks kept on chart", minval = 3, maxval = 25, group = gD, tooltip = "OB has its OWN budget, separate from FVG — a burst of FVGs can no longer push order blocks off the chart.")
showOBScore = input.bool(true, "  Show OB probability score + HPZ tier", group = gD, tooltip = "Body-momentum z-score + volume-percentile blend, 0-100 (mirrors LuxAlgo's MSB & OB Toolkit). >80 = High-Probability Zone: brighter box + ★HPZ tag. Visual/informational only — NOT wired into the confluence score.")
showFVG    = input.bool(true, "Draw fair value gaps (auto-delete on fill)", group = gD)
fvgMinAtr  = input.float(0.15, "  Min FVG gap size × ATR", minval = 0, step = 0.05, group = gD, tooltip = "On 1m gold, tiny 3-candle imbalances form constantly and stack up into an unreadable pile of boxes. This requires the gap to be at least this fraction of ATR before it's drawn — raise it to only show meaningful FVGs.")
fvgMaxKeep = input.int(8, "  Max FVGs kept on chart", minval = 2, maxval = 15, group = gD, tooltip = "FVGs form far more often than order blocks, so a smaller, separate cap keeps only the most recent/relevant ones instead of a stack of overlapping boxes.")
showHtfFVG = input.bool(true, "Draw HTF (1H/4H) fair value gaps", group = gD, tooltip = "Same 3-candle imbalance test as the chart-timeframe FVGs above, evaluated on the 1H and 4H series instead — a higher-timeframe key level, same 'major pool' tier as the CRT candle range. Informational/visual only, not wired as a sweep pool or TP target.")
htfFvgMaxKeep = input.int(4, "  Max HTF FVGs kept on chart (each of 1H/4H)", minval = 2, maxval = 8, group = gD)
showBreakers  = input.bool(true, "Draw breaker blocks (invalidated OB flips to opposite S/R)", group = gD, tooltip = "When an order block gets closed through (invalidated), it flips into support/resistance in the OPPOSITE direction — a real ICT concept, distinct from a fresh OB.")
breakerMaxKeep = input.int(8, "  Max breaker blocks kept on chart", minval = 2, maxval = 20, group = gD)
zoneMaxAge = input.int(120, "  Zone max age (bars)", minval = 10, group = gD)
showSessHL = input.bool(true, "Show last Asia / London / NY high-low", group = gD)
pressLen   = input.int(20, "Pressure look-back (up vs down displacement)", minval = 2, group = gD, tooltip = "Sums the size of up-moves vs down-moves over N bars. If sellers pushed 6 while buyers pushed 3, net pressure is DOWN — the read you described. Shown on the dashboard; add it as a filter in Extra confirmations.")
showMTF    = input.bool(true, "Show multi-timeframe confluence row (5m/15m/1h/4h/1D)", group = gD, tooltip = "At-a-glance: does price sit above/below its own 50-EMA on each higher timeframe? Purely informational, not wired to entries — just how many timeframes currently agree.")
showOpens  = input.bool(true, "Draw Daily / Weekly / Monthly open lines", group = gD, tooltip = "Informational only, not a sweep pool or TP target — just the reference price many desks use for intraday bias (above the day's open = buyers in control so far, and so on for the week/month).")

// ============================== ⑥ SESSION SHADING ===========================
gV = "⑥ Session shading (UTC)"
drawSess = input.bool(true, "Shade sessions on chart", group = gV)
asiaAM = input.session("2300-0300", "Asia morning", group = gV)
asiaPM = input.session("0300-0700", "Asia noon", group = gV)
lonAM  = input.session("0700-0930", "London morning", group = gV)
lonPM  = input.session("0930-1200", "London noon", group = gV)
nyAM   = input.session("1200-1500", "New York morning", group = gV)
nyPM   = input.session("1500-2100", "New York noon", group = gV)
blankLunch = input.bool(true, "Blank the lunch hour (no shading)", group = gV)
asiaLunch = input.session("0300-0400", "  Asia lunch", group = gV)
lonLunch  = input.session("1000-1100", "  London lunch", group = gV)
nyLunch   = input.session("1600-1700", "  New York lunch", group = gV)

// ============================== ⑦ MARKET STRUCTURE ===========================
gM = "⑦ Market structure (BOS / CHoCH / MSS) — informational, not wired to entries"
showStructure = input.bool(true, "Draw BOS / CHoCH / MSS lines", group = gM)
extSwLen = input.int(15, "  External (major) swing length", minval = 2, group = gM, tooltip = "Bars each side for a swing to count as a MAJOR/external point. These define BOS (a close beyond the swing THAT AGREES with the current structural trend = continuation) and CHoCH (a close beyond the swing that OPPOSES it = reversal). Larger = fewer, more significant lines.")
mssSwLen = input.int(4, "  Internal (minor) swing length — MSS", minval = 1, group = gM, tooltip = "Market Structure Shift: a close beyond a MINOR swing AGAINST the current trend — an early heads-up that may or may not become a full CHoCH. Smaller = earlier, noisier.")
structMaxKeep = input.int(30, "  Max structure lines kept on chart (also caps the zigzag)", minval = 5, maxval = 60, group = gM)
showZigzag = input.bool(true, "Draw price-action zigzag (swing-to-swing)", group = gM, tooltip = "Connects the same external swing points used for BOS/CHoCH with a line — green for a rising leg, red for a falling leg. This is the mechanical, non-repainting substitute for Elliott Wave: it shows the impulse/correction path without a subjective, revisable wave count.")
showPremDisc = input.bool(true, "Draw Premium / Discount / Equilibrium", group = gM, tooltip = "Uses the current external swing range (last major high & low) as the dealing range: above the 50% midpoint = Premium (favor selling), below = Discount (favor buying), the 50% line = Equilibrium.")
showSwingHL = input.bool(true, "Label HH / HL / LL / LH at each swing", group = gM, tooltip = "Mechanical (not subjective): each new major swing is compared to the previous same-type one. HH/HL = bullish structure (green), LL/LH = bearish (red). Turn off if it's too much alongside BOS/CHoCH at the same points.")
showCISD = input.bool(true, "Draw CISD (Change in State of Delivery)", group = gM, tooltip = "A close back through the OPEN of the last opposite candle before an impulse (the same reference candle as the order block, just its open — a tighter, earlier trigger than the full OB zone).")
showEQ   = input.bool(true, "Draw EQH / EQL liquidity pools", group = gM, tooltip = "Two major swings within the 'Pool: Equal Highs/Lows' tolerance (Entry group) — a real double-top/bottom-style resting-liquidity pool.")

// ============================== CALCULATIONS =================================
atr = ta.atr(atrLen)

// key levels / pools
pdh = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1],  lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1],   lookahead = barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid, "M", high[1],  lookahead = barmerge.lookahead_on)
pml = request.security(syminfo.tickerid, "M", low[1],   lookahead = barmerge.lookahead_on)

// current Daily/Weekly/Monthly OPEN — fixed the instant each period starts, so
// tracking it directly off the chart's own bars (like the session opens above)
// is simplest and non-repainting; no request.security needed for a value that
// doesn't change once set.
var float dOpenV = na
var float wOpenV = na
var float mOpenV = na
newWeekChg  = timeframe.change("W")
newMonthChg = timeframe.change("M")
if timeframe.change("D")
    dOpenV := open
if newWeekChg
    wOpenV := open
if newMonthChg
    mOpenV := open

// CRT pools: prior 1H / 4H candle high & low (Candle Range Theory / Po3 at candle scale)
h1H = request.security(syminfo.tickerid, "60",  high[1], lookahead = barmerge.lookahead_on)
h1L = request.security(syminfo.tickerid, "60",  low[1],  lookahead = barmerge.lookahead_on)
h4H = request.security(syminfo.tickerid, "240", high[1], lookahead = barmerge.lookahead_on)
h4L = request.security(syminfo.tickerid, "240", low[1],  lookahead = barmerge.lookahead_on)

// HTF (1H/4H) fair value gaps — the same 3-candle imbalance test as fvgBull/
// fvgBear below, evaluated on the 60/240 series and shifted by [1]/[3] instead
// of [0]/[2] so it always reads the last FULLY CLOSED HTF 3-candle window,
// never the still-forming HTF bar — same non-repaint idiom as h1H/h1L/h4H/h4L
// just above. Informational/visual key levels only, same tier as the same-
// timeframe FVGs already drawn — not wired as a sweep pool or TP target.
newH1Bar = timeframe.change("60")
newH4Bar = timeframe.change("240")
h1L1 = request.security(syminfo.tickerid, "60",  low[1],  lookahead = barmerge.lookahead_on)
h1H3 = request.security(syminfo.tickerid, "60",  high[3], lookahead = barmerge.lookahead_on)
h1H1 = request.security(syminfo.tickerid, "60",  high[1], lookahead = barmerge.lookahead_on)
h1L3 = request.security(syminfo.tickerid, "60",  low[3],  lookahead = barmerge.lookahead_on)
h4L1 = request.security(syminfo.tickerid, "240", low[1],  lookahead = barmerge.lookahead_on)
h4H3 = request.security(syminfo.tickerid, "240", high[3], lookahead = barmerge.lookahead_on)
h4H1 = request.security(syminfo.tickerid, "240", high[1], lookahead = barmerge.lookahead_on)
h4L3 = request.security(syminfo.tickerid, "240", low[3],  lookahead = barmerge.lookahead_on)
fvgBull1H = h1L1 > h1H3 and (h1L1 - h1H3) >= fvgMinAtr * atr
fvgBear1H = h1H1 < h1L3 and (h1L3 - h1H1) >= fvgMinAtr * atr
fvgBull4H = h4L1 > h4H3 and (h4L1 - h4H3) >= fvgMinAtr * atr
fvgBear4H = h4H1 < h4L3 and (h4L3 - h4H1) >= fvgMinAtr * atr

// optional HTF bias
htfClose = request.security(syminfo.tickerid, biasTF, close[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, biasTF, ta.ema(close, 50)[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
biasBull = htfClose > htfEma
biasBear = htfClose < htfEma

// HTF trend for candle coloring (independent custom TF)
htfcClose = request.security(syminfo.tickerid, htfColorTF, close[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfcEma   = request.security(syminfo.tickerid, htfColorTF, ta.ema(close, 50)[barstate.isrealtime ? 1 : 0], lookahead = barmerge.lookahead_off)
htfcUp = htfcClose > htfcEma
htfcDn = htfcClose < htfcEma

// multi-timeframe confluence row (informational only — close vs. its own 50-EMA
// on each TF, same "trend" test as the bias filter, just shown across several TFs)
[mtf5c,  mtf5e]  = request.security(syminfo.tickerid, "5",   [close[barstate.isrealtime ? 1 : 0], ta.ema(close, 50)[barstate.isrealtime ? 1 : 0]], lookahead = barmerge.lookahead_off)
[mtf15c, mtf15e] = request.security(syminfo.tickerid, "15",  [close[barstate.isrealtime ? 1 : 0], ta.ema(close, 50)[barstate.isrealtime ? 1 : 0]], lookahead = barmerge.lookahead_off)
[mtf60c, mtf60e] = request.security(syminfo.tickerid, "60",  [close[barstate.isrealtime ? 1 : 0], ta.ema(close, 50)[barstate.isrealtime ? 1 : 0]], lookahead = barmerge.lookahead_off)
[mtf240c,mtf240e]= request.security(syminfo.tickerid, "240", [close[barstate.isrealtime ? 1 : 0], ta.ema(close, 50)[barstate.isrealtime ? 1 : 0]], lookahead = barmerge.lookahead_off)
[mtfDc,  mtfDe]  = request.security(syminfo.tickerid, "D",   [close[barstate.isrealtime ? 1 : 0], ta.ema(close, 50)[barstate.isrealtime ? 1 : 0]], lookahead = barmerge.lookahead_off)
mtf5t   = mtf5c   > mtf5e   ? 1 : mtf5c   < mtf5e   ? -1 : 0
mtf15t  = mtf15c  > mtf15e  ? 1 : mtf15c  < mtf15e  ? -1 : 0
mtf60t  = mtf60c  > mtf60e  ? 1 : mtf60c  < mtf60e  ? -1 : 0
mtf240t = mtf240c > mtf240e ? 1 : mtf240c < mtf240e ? -1 : 0
mtfDt   = mtfDc   > mtfDe   ? 1 : mtfDc   < mtfDe   ? -1 : 0
mtfAgree = mtf5t + mtf15t + mtf60t + mtf240t + mtfDt   // -5..+5, just a count — not a calibrated probability

// optional CHoCH
ph_ = ta.pivothigh(pivLen, pivLen)
pl_ = ta.pivotlow(pivLen, pivLen)
var float lastPH = na
var float lastPL = na
if not na(ph_)
    lastPH := ph_
if not na(pl_)
    lastPL := pl_
chochUp = not na(lastPH) and ta.crossover(close, lastPH)
chochDn = not na(lastPL) and ta.crossunder(close, lastPL)
var int chochUpBar = na
var int chochDnBar = na
if chochUp
    chochUpBar := bar_index
if chochDn
    chochDnBar := bar_index
chochArmBull = not na(chochUpBar) and bar_index - chochUpBar <= 20
chochArmBear = not na(chochDnBar) and bar_index - chochDnBar <= 20

// ----- sessions: in/out + per-session OHLC for the day -----------------------
inAsia = not na(time(timeframe.period, asiaSess, sessTz))
inLon  = not na(time(timeframe.period, lonSess,  sessTz))
inNY   = not na(time(timeframe.period, nySess,   sessTz))
inLonKZ = not na(time(timeframe.period, lonKZ, sessTz))
inNyKZ  = not na(time(timeframe.period, nyKZ,  sessTz))
inSession = inAsia or inLon or inNY
inKZ      = inLonKZ or inNyKZ
inSessionOK = sessMode == "Kill zones only" ? inKZ : true
inSB = useSB and (not na(time(timeframe.period, sbLon, sessTz)) or not na(time(timeframe.period, sbAM, sessTz)) or not na(time(timeframe.period, sbPM, sessTz)))

newDay = timeframe.change("D")

// daily draw-on-liquidity proxy: which prior-day pool is still UNTAKEN today.
// If PDH hasn't been traded through yet, resting liquidity above is still a
// magnet — longs get +1 score. Mechanical stand-in for the Daily layer of the
// timeframe hierarchy (Daily = draw on liquidity).
var bool tookPDH = false
var bool tookPDL = false
if newDay
    tookPDH := false
    tookPDL := false
if not na(pdh) and high > pdh
    tookPDH := true
if not na(pdl) and low < pdl
    tookPDL := true

// trade-day filters: Monday, auto NFP (first Friday), manual news-date list
todayStr = str.tostring(year) + "-" + f_2d(month) + "-" + f_2d(dayofmonth)
bool isNewsDate = false
if str.length(newsDates) > 0
    array<string> ndParts = str.split(str.replace_all(newsDates, " ", ""), ",")
    for i = 0 to ndParts.size() - 1
        if ndParts.get(i) == todayStr
            isNewsDate := true
isNFPDay = dayofweek == dayofweek.friday and dayofmonth <= 7
tradeDayOK = not (avoidMonday and dayofweek == dayofweek.monday) and not (avoidNFP and isNFPDay) and not isNewsDate

var float asiaO = na
var float asiaH = na
var float asiaL = na
var float asiaC = na
if inAsia and not inAsia[1]
    asiaO := open
    asiaH := high
    asiaL := low
    asiaC := close
else if inAsia
    asiaH := math.max(asiaH, high)
    asiaL := math.min(asiaL, low)
    asiaC := close

var float lonO = na
var float lonH = na
var float lonL = na
var float lonC = na
if inLon and not inLon[1]
    lonO := open
    lonH := high
    lonL := low
    lonC := close
else if inLon
    lonH := math.max(lonH, high)
    lonL := math.min(lonL, low)
    lonC := close

var float nyO = na
var float nyH = na
var float nyL = na
var float nyC = na
if inNY and not inNY[1]
    nyO := open
    nyH := high
    nyL := low
    nyC := close
else if inNY
    nyH := math.max(nyH, high)
    nyL := math.min(nyL, low)
    nyC := close

// ----- classify each session at its end; roll the "last session"; count roles
var float lastSessHi = na
var float lastSessLo = na
var string lastSessName = "—"
var string lastSessPhase = "—"
var int lastSessDir = 0
var float refAsia = na
var float refLon  = na
var float refNY   = na
var string asiaPhase = "—"
var string lonPhase  = "—"
var string nyPhase   = "—"
var int aA = 0
var int aM = 0
var int aD = 0
var int lA = 0
var int lM = 0
var int lD = 0
var int nA = 0
var int nM = 0
var int nD = 0

if newDay
    asiaPhase := "—"
    lonPhase := "—"
    nyPhase := "—"

endAsia = not inAsia and inAsia[1]
endLon  = not inLon  and inLon[1]
endNY   = not inNY   and inNY[1]

if endAsia
    [phA, drA] = f_phase(asiaO, asiaH, asiaL, asiaC, lastSessHi, lastSessLo, refAsia, expandMult, dirThresh)
    asiaPhase := phA
    aA := aA + (phA == "Accum" ? 1 : 0)
    aM := aM + (phA == "Manip" ? 1 : 0)
    aD := aD + (phA == "Distrib" ? 1 : 0)
    lastSessHi := asiaH
    lastSessLo := asiaL
    lastSessName := "Asia"
    lastSessPhase := phA
    lastSessDir := drA
    refAsia := na(refAsia) ? asiaH - asiaL : refAsia * 0.8 + (asiaH - asiaL) * 0.2
if endLon
    [phL, drL] = f_phase(lonO, lonH, lonL, lonC, lastSessHi, lastSessLo, refLon, expandMult, dirThresh)
    lonPhase := phL
    lA := lA + (phL == "Accum" ? 1 : 0)
    lM := lM + (phL == "Manip" ? 1 : 0)
    lD := lD + (phL == "Distrib" ? 1 : 0)
    lastSessHi := lonH
    lastSessLo := lonL
    lastSessName := "London"
    lastSessPhase := phL
    lastSessDir := drL
    refLon := na(refLon) ? lonH - lonL : refLon * 0.8 + (lonH - lonL) * 0.2
if endNY
    [phN, drN] = f_phase(nyO, nyH, nyL, nyC, lastSessHi, lastSessLo, refNY, expandMult, dirThresh)
    nyPhase := phN
    nA := nA + (phN == "Accum" ? 1 : 0)
    nM := nM + (phN == "Manip" ? 1 : 0)
    nD := nD + (phN == "Distrib" ? 1 : 0)
    lastSessHi := nyH
    lastSessLo := nyL
    lastSessName := "NewYork"
    lastSessPhase := phN
    lastSessDir := drN
    refNY := na(refNY) ? nyH - nyL : refNY * 0.8 + (nyH - nyL) * 0.2

expectTxt = lastSessPhase == "Accum" ? "SWEEP likely (manip)" : lastSessPhase == "Manip" ? "DISTRIB " + (lastSessDir == 1 ? "▲ up" : "▼ down") : lastSessPhase == "Distrib" ? "pullback / accum" : "—"

// ----- candlestick trigger ---------------------------------------------------
bodyC = math.abs(close - open)
rngC  = high - low
upWk  = high - math.max(close, open)
dnWk  = math.min(close, open) - low
isDoji  = rngC > 0 and bodyC <= 0.1 * rngC
bullEng = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
bearEng = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
bullPin = rngC > 0 and dnWk >= wickMult * bodyC and (high - close) <= 0.45 * rngC
bearPin = rngC > 0 and upWk >= wickMult * bodyC and (close - low) <= 0.45 * rngC
bullMar = close > open and bodyC >= 1.0 * atr
bearMar = open > close and bodyC >= 1.0 * atr
bullConf = (bullEng or bullPin or bullMar) and not isDoji
bearConf = (bearEng or bearPin or bearMar) and not isDoji
cndName = isDoji ? "doji" : (bullEng or bearEng) ? "engulf" : (bullPin or bearPin) ? "pin" : (bullMar or bearMar) ? "strong" : "—"

// ----- net displacement pressure (up-moves vs down-moves, your 3-vs-6 read) ---
upDisp   = math.max(close - open, 0)
dnDisp   = math.max(open - close, 0)
netPress = math.sum(upDisp, pressLen) - math.sum(dnDisp, pressLen)
pressBull = netPress > 0
pressBear = netPress < 0

// ----- volume-pressure candle coloring (order-flow-ish, tick volume caveat) ---
volAvgC  = ta.sma(volume, 20)
relVolC  = volume / math.max(volAvgC, 1)
volPressUp = relVolC >= volColorMult and close > open
volPressDn = relVolC >= volColorMult and close < open

// ----- order block / FVG detection (drawn + auto-deleted below) ---------------
dispUp = close - open > atr
dispDn = open - close > atr
obBull = dispUp and close[1] < open[1]   // last down candle before an up impulse = demand
obBear = dispDn and close[1] > open[1]   // last up candle before a down impulse = supply

// ----- OB probability score (visual/informational tier only — see showOBScore
// tooltip). Body-momentum z-score (how big was this impulse candle vs its own
// recent normal) blended with a volume-percentile read, same shape as the
// Deeper-Pool Guard's isMajorSweepVol classification above but scored 0-100
// instead of a simple boolean. NOT wired into the confluence score: overlap-
// checking which OB a live setup sits inside would need a parallel array kept
// in sync across both the aging AND breaker-conversion eviction paths, too
// bug-prone for a purely informational tier label.
obMomZ   = (bodyC - ta.sma(bodyC, 50)) / ta.stdev(bodyC, 50)
obVolPct = ta.percentrank(volume, 100)
obScore  = math.min(100.0, math.abs(obMomZ) * 20 + obVolPct * 0.5)
obIsHPZ  = obScore > 80
fvgBull = low > high[2] and (low - high[2]) >= fvgMinAtr * atr   // 3-candle imbalance up, meaningful size only
fvgBear = high < low[2] and (low[2] - high) >= fvgMinAtr * atr   // 3-candle imbalance down, meaningful size only
swingLoN = ta.lowest(low,  slSwingLook)   // recent liquidity below (for SL beyond the sweep)
swingHiN = ta.highest(high, slSwingLook)  // recent liquidity above

// ----- swing points (major/minor) + EQH/EQL — computed early because the -----
// sweep-pool detection right below needs eqhLvl/eqlLvl. BOS/CHoCH/MSS break-
// detection (which also uses these swings) stays further down, unaffected.
extPH = ta.pivothigh(extSwLen, extSwLen)
extPL = ta.pivotlow(extSwLen, extSwLen)
minPH = ta.pivothigh(mssSwLen, mssSwLen)
minPL = ta.pivotlow(mssSwLen, mssSwLen)

var float extPHVal = na
var int   extPHBar = na
var float extPLVal = na
var int   extPLBar = na
var float minPHVal = na
var int   minPHBar = na
var float minPLVal = na
var int   minPLBar = na
var bool  extPHBroken = false
var bool  extPLBroken = false
var bool  minPHBroken = false
var bool  minPLBroken = false
// HH / HL / LL / LH: classify each new swing against the PREVIOUS same-type one.
var string hiSwingLabel = "—"
var string loSwingLabel = "—"
// EQH / EQL: two major swings of the same type within eqTol×ATR of each other =
// a real resting-liquidity pool (ICT/SMC), not just any single swept level.
// eqhSwept/eqlSwept gates it like the BOS "broken" flags — fires once per pool,
// then waits for a fresh equal pair, so a stale pool can't re-trigger forever.
var float eqhLvl   = na
var int   eqhBar   = na
var bool  eqhSwept = true
bool eqhNew = false
var float eqlLvl   = na
var int   eqlBar   = na
var bool  eqlSwept = true
bool eqlNew = false
if not na(extPH)
    if not na(extPHVal) and math.abs(extPH - extPHVal) <= eqTol * atr
        eqhLvl   := math.max(extPH, extPHVal)
        eqhBar   := extPHBar
        eqhSwept := false
        eqhNew   := true
    hiSwingLabel := na(extPHVal) ? "H" : (extPH > extPHVal ? "HH" : "LH")
    extPHVal := extPH
    extPHBar := bar_index - extSwLen
    extPHBroken := false
if not na(extPL)
    if not na(extPLVal) and math.abs(extPL - extPLVal) <= eqTol * atr
        eqlLvl   := math.min(extPL, extPLVal)
        eqlBar   := extPLBar
        eqlSwept := false
        eqlNew   := true
    loSwingLabel := na(extPLVal) ? "L" : (extPL > extPLVal ? "HL" : "LL")
    extPLVal := extPL
    extPLBar := bar_index - extSwLen
    extPLBroken := false
if not na(minPH)
    minPHVal := minPH
    minPHBar := bar_index - mssSwLen
    minPHBroken := false
if not na(minPL)
    minPLVal := minPL
    minPLBar := bar_index - mssSwLen
    minPLBroken := false

// ----- premium / discount / equilibrium — the current external swing range ---
// (Moved up here, ahead of the sweep/entry section below, because the OTE zone
// derived from it is now an optional entry filter, not just a drawn overlay.)
pdHasRange = not na(extPHVal) and not na(extPLVal)
pdRangeTop = pdHasRange ? math.max(extPHVal, extPLVal) : na
pdRangeBot = pdHasRange ? math.min(extPHVal, extPLVal) : na
pdEq       = pdHasRange ? (pdRangeTop + pdRangeBot) / 2 : na
pdLeftBar  = pdHasRange ? math.min(extPHBar, extPLBar) : na

// ----- OTE (Optimal Trade Entry) — the 61.8%-78.6% "golden ratio" Fibonacci
// pullback zone within the same swing range, measured from either end. This is
// the standard ICT refinement on top of Premium/Discount's plain 50% split —
// likely what a "golden ratio secret" in this space actually refers to.
oteLongTop  = pdHasRange ? pdRangeBot + (pdRangeTop - pdRangeBot) * 0.382 : na   // 61.8% retrace from the top
oteLongBot  = pdHasRange ? pdRangeBot + (pdRangeTop - pdRangeBot) * 0.214 : na   // 78.6% retrace from the top
oteShortBot = pdHasRange ? pdRangeBot + (pdRangeTop - pdRangeBot) * 0.618 : na   // 61.8% up from the bottom
oteShortTop = pdHasRange ? pdRangeBot + (pdRangeTop - pdRangeBot) * 0.786 : na   // 78.6% up from the bottom
oteOkBull = pdHasRange and close <= oteLongTop and close >= oteLongBot
oteOkBear = pdHasRange and close <= oteShortTop and close >= oteShortBot

// ----- liquidity sweep (the manipulation, in real time) ----------------------
sweepLoNow = (usePoolSess and f_swLo(lastSessLo)) or (usePoolPD and f_swLo(pdl)) or (usePoolPW and f_swLo(pwl)) or (usePoolAsia and f_swLo(asiaL)) or (usePoolEQ and not eqlSwept and f_swLo(eqlLvl)) or (usePoolPM and f_swLo(pml))
sweepHiNow = (usePoolSess and f_swHi(lastSessHi)) or (usePoolPD and f_swHi(pdh)) or (usePoolPW and f_swHi(pwh)) or (usePoolAsia and f_swHi(asiaH)) or (usePoolEQ and not eqhSwept and f_swHi(eqhLvl)) or (usePoolPM and f_swHi(pmh))
if usePoolEQ and not eqlSwept and f_swLo(eqlLvl)
    eqlSwept := true
if usePoolEQ and not eqhSwept and f_swHi(eqhLvl)
    eqhSwept := true
swLoName = (usePoolSess and f_swLo(lastSessLo)) ? lastSessName + "·L" : (usePoolPD and f_swLo(pdl)) ? "PDL" : (usePoolPW and f_swLo(pwl)) ? "PWL" : (usePoolPM and f_swLo(pml)) ? "PML" : (usePoolAsia and f_swLo(asiaL)) ? "Asia·L" : (usePoolEQ and f_swLo(eqlLvl)) ? "EQL" : "—"
swHiName = (usePoolSess and f_swHi(lastSessHi)) ? lastSessName + "·H" : (usePoolPD and f_swHi(pdh)) ? "PDH" : (usePoolPW and f_swHi(pwh)) ? "PWH" : (usePoolPM and f_swHi(pmh)) ? "PMH" : (usePoolAsia and f_swHi(asiaH)) ? "Asia·H" : (usePoolEQ and f_swHi(eqhLvl)) ? "EQH" : "—"

// ----- SMT divergence: a correlated market fails to confirm the new extreme ---
smtRefLow  = request.security(smtSym, timeframe.period, low,  lookahead = barmerge.lookahead_off)
smtRefHigh = request.security(smtSym, timeframe.period, high, lookahead = barmerge.lookahead_off)
gLL = low  < ta.lowest(low,  smtLen)[1]
gHH = high > ta.highest(high, smtLen)[1]
rLL = smtRefLow  < ta.lowest(smtRefLow,  smtLen)[1]
rHH = smtRefHigh > ta.highest(smtRefHigh, smtLen)[1]
smtBull = smtCorr == "Positive" ? (gLL and not rLL) : (gLL and not rHH)
smtBear = smtCorr == "Positive" ? (gHH and not rHH) : (gHH and not rLL)

// ----- non-ICT confluence: VWAP side, RSI divergence, volume climax ----------
// All three measure the SAME stop-run event from different angles — not lagging
// trend tools. VWAP: buying a swept low BELOW vwap = discount with reversion
// room (volume-anchored premium/discount). RSI divergence: momentum failed to
// confirm the new extreme (SMT's logic without needing a second symbol).
// Volume climax: stops actually ran on the sweep bar, not a quiet drift through.
// VWAP with ±1σ bands = poor-man's value area (VWAP ≈ POC, bands ≈ VAH/VAL on
// most balanced days — a documented approximation of the market-profile value
// area without a full TPO engine). A sweep OUTSIDE value that reclaims = the
// "failed auction / rejection at the extremes" read, scored at arm time.
[vwapVal, vwapUp, vwapLo] = ta.vwap(hlc3, timeframe.change("D"), 1.0)
rsiV = ta.rsi(close, 14)
rsiBullDiv = gLL and rsiV > ta.lowest(rsiV, smtLen)[1]
rsiBearDiv = gHH and rsiV < ta.highest(rsiV, smtLen)[1]
volClimax = relVolC >= volColorMult
// major-vs-minor sweep classification by volume PERCENTILE RANK (over the last
// 100 bars) rather than a flat multiple-of-average — a real "was this bar's
// volume actually unusual for this instrument recently" read, not just a
// fixed ratio. Replaces volClimax specifically in the confluence score below;
// volClimax itself is untouched and still drives the separate Volume Pressure
// candle-coloring display.
sweepVolRank = ta.percentrank(volume, 100)
isMajorSweepVol = sweepVolRank >= majorSweepThresh

// ----- market structure: BOS (continuation) / CHoCH (reversal) / MSS (minor) --
// Independent of the entry/filter logic above — purely informational annotation.
// (Swing points themselves are computed earlier, before the sweep section above,
// since EQH/EQL now feeds pool detection there — this part is just break-detection.)
// BOS  = a body-close beyond the EXTERNAL swing that AGREES with the current
//        structural trend (trend intact, matches Justin Bennett / ICT usage).
// CHoCH= a body-close beyond the EXTERNAL swing that OPPOSES it (trend flips).
// MSS  = a body-close beyond a MINOR (internal) swing against the trend — an
//        early warning that may or may not become a full CHoCH.

var int structTrend = 0
// Gated by the "broken" flag so a level fires ONCE, not every re-cross until a
// fresh swing replaces it — fixes BOS/CHoCH/MSS repeating many times over.
extBullBreak = barstate.isconfirmed and not na(extPHVal) and not extPHBroken and ta.crossover(close, extPHVal)
extBearBreak = barstate.isconfirmed and not na(extPLVal) and not extPLBroken and ta.crossunder(close, extPLVal)
minBullBreak = barstate.isconfirmed and not na(minPHVal) and not minPHBroken and ta.crossover(close, minPHVal)
minBearBreak = barstate.isconfirmed and not na(minPLVal) and not minPLBroken and ta.crossunder(close, minPLVal)

isBosUp   = extBullBreak and structTrend == 1
isChochUp = extBullBreak and structTrend != 1
isBosDn   = extBearBreak and structTrend == -1
isChochDn = extBearBreak and structTrend != -1
isMssUp   = minBullBreak and structTrend == -1 and not isChochUp
isMssDn   = minBearBreak and structTrend == 1 and not isChochDn

if extBullBreak
    extPHBroken := true
    structTrend := 1
if extBearBreak
    extPLBroken := true
    structTrend := -1
if minBullBreak
    minPHBroken := true
if minBearBreak
    minPLBroken := true

// ----- CISD (Change in State of Delivery): close back through the OPEN of the
// last opposite candle before the impulse — the same reference candle used for
// the order block, just a tighter trigger (its open, not the whole zone).
var float cisdBullLvl  = na
var int   cisdBullBar  = na
var bool  cisdBullDone = false
var float cisdBearLvl  = na
var int   cisdBearBar  = na
var bool  cisdBearDone = false
if obBull
    cisdBullLvl := open[1]
    cisdBullBar := bar_index - 1
    cisdBullDone := false
if obBear
    cisdBearLvl := open[1]
    cisdBearBar := bar_index - 1
    cisdBearDone := false
cisdBullConfirm = barstate.isconfirmed and not na(cisdBullLvl) and not cisdBullDone and ta.crossover(close, cisdBullLvl)
cisdBearConfirm = barstate.isconfirmed and not na(cisdBearLvl) and not cisdBearDone and ta.crossunder(close, cisdBearLvl)
if cisdBullConfirm
    cisdBullDone := true
if cisdBearConfirm
    cisdBearDone := true

// Breaker-block arrays declared EARLY (populated in the drawing section below
// from invalidated OBs) because the confluence score checks the entry zone
// against them — unicorn model: breaker ∩ entry FVG/zone = +1.
var array<box> bullBreakers = array.new<box>()   // former SUPPLY OB, broken up through -> now support
var array<box> bearBreakers = array.new<box>()   // former DEMAND OB, broken down through -> now resistance

// ============================== STATE MACHINE ================================
var bool  inTrade  = false
var int   dir      = 0
var float entryP   = na
var float slP      = na
var float tpP      = na
var float riskDist = na
var float tradeRR  = na
var int   entryBar = na
var int   pendDir  = 0
var float zLvl     = na
var float pendDeeperLvl = na   // deeper untaken pool beyond the swept level, if found at arm time
var int   pendBar  = na
var int   lastExitBar = na
var int   nT = 0
var int   nW = 0
var float grW = 0.0
var float grL = 0.0
var bool  entryGuardFired = false   // did THIS trade's setup wait for/anchor to a deeper untaken pool?
var bool  pendMajorVol = false   // was the sweep bar's volume a MAJOR (percentile-ranked) sweep?

cooled = na(lastExitBar) or bar_index - lastExitBar >= cooldownBars

longSig   = false
shortSig  = false
tpHit     = false
slHit     = false
exitEarly = false

// ----- 2-stage retest flow: arm on the sweep, enter on the retest close ------
// EQ pools included here too — sweepLoNow/sweepHiNow can fire on an EQH/EQL
// sweep alone, and the retest state needs a real zLvl for it, not na.
swpLoPrice = (usePoolSess and f_swLo(lastSessLo)) ? lastSessLo : (usePoolPD and f_swLo(pdl)) ? pdl : (usePoolPW and f_swLo(pwl)) ? pwl : (usePoolPM and f_swLo(pml)) ? pml : (usePoolAsia and f_swLo(asiaL)) ? asiaL : (usePoolEQ and f_swLo(eqlLvl)) ? eqlLvl : na
swpHiPrice = (usePoolSess and f_swHi(lastSessHi)) ? lastSessHi : (usePoolPD and f_swHi(pdh)) ? pdh : (usePoolPW and f_swHi(pwh)) ? pwh : (usePoolPM and f_swHi(pmh)) ? pmh : (usePoolAsia and f_swHi(asiaH)) ? asiaH : (usePoolEQ and f_swHi(eqhLvl)) ? eqhLvl : na
strongLo = f_touches(swpLoPrice, srTol * atr, srLook) >= srTouches
strongHi = f_touches(swpHiPrice, srTol * atr, srLook) >= srTouches
armBullNow = sweepLoNow and inSessionOK and tradeDayOK and (not requireBias or biasBull) and (not requireChoch or chochArmBull) and (not requireSMT or smtBull) and (not useStrongSR or strongLo) and (not requirePress or pressBull) and (not requireOTE or oteOkBull)
armBearNow = sweepHiNow and inSessionOK and tradeDayOK and (not requireBias or biasBear) and (not requireChoch or chochArmBear) and (not requireSMT or smtBear) and (not useStrongSR or strongHi) and (not requirePress or pressBear) and (not requireOTE or oteOkBear)
strictICT = confirmModel == "Strict ICT: displacement → FVG retest"
// strict-ICT confirmation state, per pending setup: the sweep arms it, then a
// DISPLACEMENT candle must leave an FVG (captured below as the entry zone) and
// a CISD or MSS must print in the reversal direction. Only then does the
// retrace INTO that FVG become the entry — manipulation → displacement →
// return to imbalance, ICT's actual sequence.
var bool  confStruct = false
var float fvgETop = na
var float fvgEBot = na
var int   fvgEBar = na
var int   armScore = 0
if armBullNow
    pendDir := 1
    zLvl := swpLoPrice
    pendBar := bar_index
    confStruct := false
    fvgETop := na
    fvgEBot := na
    fvgEBar := na
    // deeper-pullback check, locked in on the sweep bar just like zLvl itself:
    // is there a still-untaken pool below the level that just got swept?
    pendDeeperLvl := useDeeperGuard ? f_deeperPool(1, zLvl, deeperGuardAtr * atr, pdh, pdl, pwh, pwl, lastSessHi, lastSessLo, asiaH, asiaL, pmh, pml) : na
    // arm-time confluence, locked in on the sweep bar
    int aS = ((usePoolPD and f_swLo(pdl)) or (usePoolPW and f_swLo(pwl)) or (usePoolPM and f_swLo(pml)) or (usePoolCRT and f_swLo(h4L))) ? 2 : 1
    aS += (lastSessPhase == "Accum" or (lastSessPhase == "Manip" and lastSessDir == 1)) ? 1 : 0
    aS += smtBull ? 1 : 0
    aS += oteOkBull ? 1 : 0
    aS += rsiBullDiv ? 1 : 0
    aS += isMajorSweepVol ? 1 : 0
    aS += low < vwapLo ? 1 : 0        // swept OUTSIDE value area — failed auction below
    aS += not tookPDH ? 1 : 0         // daily draw above still untaken — magnet in trade direction
    armScore := aS
    pendMajorVol := isMajorSweepVol
if armBearNow
    pendDir := -1
    zLvl := swpHiPrice
    pendBar := bar_index
    confStruct := false
    fvgETop := na
    fvgEBot := na
    fvgEBar := na
    pendDeeperLvl := useDeeperGuard ? f_deeperPool(-1, zLvl, deeperGuardAtr * atr, pdh, pdl, pwh, pwl, lastSessHi, lastSessLo, asiaH, asiaL, pmh, pml) : na
    int aS = ((usePoolPD and f_swHi(pdh)) or (usePoolPW and f_swHi(pwh)) or (usePoolPM and f_swHi(pmh)) or (usePoolCRT and f_swHi(h4H))) ? 2 : 1
    aS += (lastSessPhase == "Accum" or (lastSessPhase == "Manip" and lastSessDir == -1)) ? 1 : 0
    aS += smtBear ? 1 : 0
    aS += oteOkBear ? 1 : 0
    aS += rsiBearDiv ? 1 : 0
    aS += isMajorSweepVol ? 1 : 0
    aS += high > vwapUp ? 1 : 0       // swept OUTSIDE value area — failed auction above
    aS += not tookPDL ? 1 : 0         // daily draw below still untaken — magnet in trade direction
    armScore := aS
    pendMajorVol := isMajorSweepVol
// capture the FIRST displacement FVG after the sweep (dispUp[1]/dispDn[1] =
// the FVG's middle candle was a true displacement body, not drift) and the
// structure shift. fvgETop is always the zone's upper price, fvgEBot the lower.
// Tracked in BOTH modes now: strict uses them as the entry requirement, classic
// earns +2 each in the confluence score when they show up.
if pendDir == 1
    if cisdBullConfirm or minBullBreak
        confStruct := true
    if fvgBull and dispUp[1] and na(fvgEBar)
        fvgETop := low
        fvgEBot := high[2]
        fvgEBar := bar_index
if pendDir == -1
    if cisdBearConfirm or minBearBreak
        confStruct := true
    if fvgBear and dispDn[1] and na(fvgEBar)
        fvgETop := low[2]
        fvgEBot := high
        fvgEBar := bar_index
// effective retest level: the deeper untaken pool when the guard found one,
// otherwise the shallow swept level exactly as before — so with the guard
// off, or when no deeper pool exists, this is a no-op and behavior is
// unchanged. When a deeper pool DOES exist, everything below (invalidation,
// the classic retest touch, and the stop anchor further down) shifts to it —
// the setup won't fire until price actually pulls back that far.
float effLvl = not na(pendDeeperLvl) ? pendDeeperLvl : zLvl
// invalidations: close back through the effective level, timeout, or (strict)
// the displacement FVG itself getting closed through — the manipulation failed
if pendDir == 1 and (close < effLvl - retestTol * atr or bar_index - pendBar > retestBars or (strictICT and not na(fvgEBar) and close < fvgEBot))
    pendDir := 0
if pendDir == -1 and (close > effLvl + retestTol * atr or bar_index - pendBar > retestBars or (strictICT and not na(fvgEBar) and close > fvgETop))
    pendDir := 0
// classic: retest of the effective level; strict: retrace INTO the displacement FVG.
// inSessionOK on the ENTRY bar too, not just the sweep — a setup armed at the
// end of a killzone doesn't get filled outside it. Unfilled = fine, no FOMO.
retestBull = pendDir == 1 and bar_index > pendBar and low  <= effLvl + retestTol * atr and (not useCandle or bullConf) and inSessionOK
retestBear = pendDir == -1 and bar_index > pendBar and high >= effLvl - retestTol * atr and (not useCandle or bearConf) and inSessionOK
strictBull = pendDir == 1 and confStruct and not na(fvgEBar) and bar_index > fvgEBar and low  <= fvgETop and (not useCandle or bullConf) and inSessionOK
strictBear = pendDir == -1 and confStruct and not na(fvgEBar) and bar_index > fvgEBar and high >= fvgEBot and (not useCandle or bearConf) and inSessionOK

// confluence score — one dial for frequency ↔ quality instead of ten hard
// gates. Arm-time factors were locked in when the sweep fired (armScore);
// post-sweep confirmations and entry-bar context are added live.
int liveScore = armScore
liveScore += inKZ ? 2 : inSession ? 1 : 0
liveScore += inSB ? 1 : 0
liveScore += not na(fvgEBar) ? 2 : 0
liveScore += confStruct ? 2 : 0
// unicorn model: the zone we intend to enter from overlaps a breaker block
float uzTop = not na(fvgEBar) ? fvgETop : not na(effLvl) ? effLvl + retestTol * atr : na
float uzBot = not na(fvgEBar) ? fvgEBot : not na(effLvl) ? effLvl - retestTol * atr : na
if pendDir == 1
    liveScore += pressBull ? 1 : 0
    liveScore += close < vwapVal ? 1 : 0
    liveScore += biasBull ? 1 : 0
    liveScore += mtfAgree >= 3 ? 1 : 0
    liveScore += f_overlapsAny(bullBreakers, uzTop, uzBot) ? 1 : 0
if pendDir == -1
    liveScore += pressBear ? 1 : 0
    liveScore += close > vwapVal ? 1 : 0
    liveScore += biasBear ? 1 : 0
    liveScore += mtfAgree <= -3 ? 1 : 0
    liveScore += f_overlapsAny(bearBreakers, uzTop, uzBot) ? 1 : 0
scoreOK = minScore <= 0 or liveScore >= minScore

trigBull = (strictICT ? strictBull : retestBull) and scoreOK and tradeDayOK
trigBear = (strictICT ? strictBear : retestBear) and scoreOK and tradeDayOK

if barstate.isconfirmed
    if inTrade
        bool  doExit = false
        float exitP  = na
        bool hitS = dir == 1 ? low  <= slP : high >= slP
        bool hitT = dir == 1 ? high >= tpP : low  <= tpP
        if hitS
            exitP := slP
            doExit := true
            slHit := true
        else if hitT
            exitP := tpP
            doExit := true
            tpHit := true
        else if useFailExit and (dir == 1 ? sweepHiNow : sweepLoNow)
            exitP := close
            doExit := true
            exitEarly := true
        else if useTimeStop and bar_index - entryBar >= maxBars
            exitP := close
            doExit := true
            exitEarly := true
        if doExit
            float r = dir * (exitP - entryP) / riskDist
            nT := nT + 1
            nW := nW + (r > 0 ? 1 : 0)
            grW := grW + (r > 0 ? r : 0.0)
            grL := grL + (r < 0 ? -r : 0.0)
            lastExitBar := bar_index
            inTrade := false
            dir := 0
    if not inTrade and cooled and (trigBull or trigBear)
        int d = trigBull ? 1 : -1
        float eP = close
        // protLvl now anchors to effLvl — the deeper untaken pool when the
        // guard found one at arm time, otherwise the shallow swept level
        // exactly as before. No post-hoc widening needed: since the retest
        // itself was required to reach effLvl, the stop naturally sits just
        // beyond the REAL level the setup ended up honoring, from the start.
        float protLvl = d == 1 ? (not na(effLvl) ? math.min(effLvl, low) : low) : (not na(effLvl) ? math.max(effLvl, high) : high)
        float protSwing = d == 1 ? swingLoN : swingHiN
        float prot = not slBeyondSwing ? protLvl : (d == 1 ? math.min(protLvl, protSwing) : math.max(protLvl, protSwing))
        float rawSL = stopMode == "Beyond key level" ? (d == 1 ? prot - slBuf * atr : prot + slBuf * atr) : (d == 1 ? math.min(low, prot) - slBuf * atr : math.max(high, prot) + slBuf * atr)
        float floorSL = d == 1 ? eP - minStopAtr * atr : eP + minStopAtr * atr
        rawSL := d == 1 ? math.min(rawSL, floorSL) : math.max(rawSL, floorSL)
        float minR = 0.2 * atr
        if d == 1 and rawSL > eP - minR
            rawSL := eP - minR
        if d == -1 and rawSL < eP + minR
            rawSL := eP + minR
        float rD = math.abs(eP - rawSL)
        // a level only qualifies as a target if taking tpKeyLevelPct of the way
        // there still clears the minimum RR floor
        float minTPdist = rD * minRRfloor / tpKeyLevelPct
        float t = na
        if d == 1
            if not na(pdh) and pdh > eP + minTPdist
                t := pdh
            if not na(pwh) and pwh > eP + minTPdist and (na(t) or pwh < t)
                t := pwh
            if not na(pmh) and pmh > eP + minTPdist and (na(t) or pmh < t)
                t := pmh
            if not na(lastSessHi) and lastSessHi > eP + minTPdist and (na(t) or lastSessHi < t)
                t := lastSessHi
            if not na(asiaH) and asiaH > eP + minTPdist and (na(t) or asiaH < t)
                t := asiaH
            if usePoolCRT and not na(h1H) and h1H > eP + minTPdist and (na(t) or h1H < t)
                t := h1H
            if usePoolCRT and not na(h4H) and h4H > eP + minTPdist and (na(t) or h4H < t)
                t := h4H
        else
            if not na(pdl) and pdl < eP - minTPdist
                t := pdl
            if not na(pwl) and pwl < eP - minTPdist and (na(t) or pwl > t)
                t := pwl
            if not na(pml) and pml < eP - minTPdist and (na(t) or pml > t)
                t := pml
            if not na(lastSessLo) and lastSessLo < eP - minTPdist and (na(t) or lastSessLo > t)
                t := lastSessLo
            if not na(asiaL) and asiaL < eP - minTPdist and (na(t) or asiaL > t)
                t := asiaL
            if usePoolCRT and not na(h1L) and h1L < eP - minTPdist and (na(t) or h1L > t)
                t := h1L
            if usePoolCRT and not na(h4L) and h4L < eP - minTPdist and (na(t) or h4L > t)
                t := h4L
        // no structural target in reach = no trade (unless the user opted into
        // the fixed-RR fallback). Either way the pending setup is consumed.
        if not na(t) or not requireLevelTP
            dir := d
            entryP := eP
            slP := rawSL
            riskDist := rD
            tpP := not na(t) ? eP + d * math.abs(t - eP) * tpKeyLevelPct : eP + d * rr * rD
            tradeRR := math.abs(tpP - entryP) / riskDist
            entryBar := bar_index
            inTrade := true
            entryGuardFired := not na(pendDeeperLvl)
            longSig := trigBull
            shortSig := trigBear
        pendDir := 0

// ============================== STATS ========================================
winRate = nT > 0 ? nW / nT * 100 : 0.0
pf      = grL > 0 ? grW / grL : (grW > 0 ? 999.0 : 0.0)

// ============================== DRAWING ======================================
plot(drawLevels and usePoolPD ? pdh : na, "PDH", color.new(colBear, 40),    1, plot.style_linebr)
plot(drawLevels and usePoolPD ? pdl : na, "PDL", color.new(colBull, 40),  1, plot.style_linebr)
plot(drawLevels and usePoolPW ? pwh : na, "PWH", color.new(color.orange, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolPW ? pwl : na, "PWL", color.new(color.orange, 30), 1, plot.style_linebr)
plot(drawLevels and usePoolPM ? pmh : na, "PMH", color.new(color.purple, 20), 2, plot.style_linebr)
plot(drawLevels and usePoolPM ? pml : na, "PML", color.new(color.purple, 20), 2, plot.style_linebr)

// Daily / Weekly / Monthly open — informational reference line, not a pool
plot(showOpens ? dOpenV : na, "Day Open",   color.new(color.gray, 50),   1, plot.style_linebr)
plot(showOpens ? wOpenV : na, "Week Open",  color.new(color.orange, 50), 1, plot.style_linebr)
plot(showOpens ? mOpenV : na, "Month Open", color.new(color.purple, 50), 1, plot.style_linebr)
plot(drawLevels and usePoolSess ? lastSessHi : na, "Last H", color.new(color.gray, 20), 1, plot.style_linebr)
plot(drawLevels and usePoolSess ? lastSessLo : na, "Last L", color.new(color.gray, 20), 1, plot.style_linebr)

// last Asia / London / New York high-low (always visible = the liquidity pools)
plot(showSessHL ? asiaH : na, "Asia H",   color.new(color.aqua, 20),   1, plot.style_linebr)
plot(showSessHL ? asiaL : na, "Asia L",   color.new(color.aqua, 20),   1, plot.style_linebr)
plot(showSessHL ? lonH  : na, "London H", color.new(color.lime, 20),   1, plot.style_linebr)
plot(showSessHL ? lonL  : na, "London L", color.new(color.lime, 20),   1, plot.style_linebr)
plot(showSessHL ? nyH   : na, "NY H",     color.new(color.orange, 20), 1, plot.style_linebr)
plot(showSessHL ? nyL   : na, "NY L",     color.new(color.orange, 20), 1, plot.style_linebr)

// small name-tag on every level line, at the right edge — no more guessing which is which
var label lblPDH = na
var label lblPDL = na
var label lblPWH = na
var label lblPWL = na
var label lblPMH = na
var label lblPML = na
var label lblDOpen = na
var label lblWOpen = na
var label lblMOpen = na
var label lblLastH = na
var label lblLastL = na
var label lblAsiaH = na
var label lblAsiaL = na
var label lblLonH = na
var label lblLonL = na
var label lblNyH = na
var label lblNyL = na
if barstate.islast
    int xT = bar_index + 8
    // touch-count each level against the SAME "strong S/R" tolerance/lookback/threshold
    // used by the optional filter (srTol/srLook/srTouches) — so you can visually SEE
    // which levels would actually pass "Require strong (tested) level" before turning it on.
    int tPDH  = f_touches(pdh, srTol * atr, srLook)
    int tPDL  = f_touches(pdl, srTol * atr, srLook)
    int tPWH  = f_touches(pwh, srTol * atr, srLook)
    int tPWL  = f_touches(pwl, srTol * atr, srLook)
    int tPMH  = f_touches(pmh, srTol * atr, srLook)
    int tPML  = f_touches(pml, srTol * atr, srLook)
    int tLstH = f_touches(lastSessHi, srTol * atr, srLook)
    int tLstL = f_touches(lastSessLo, srTol * atr, srLook)
    int tAsH  = f_touches(asiaH, srTol * atr, srLook)
    int tAsL  = f_touches(asiaL, srTol * atr, srLook)
    int tLoH  = f_touches(lonH, srTol * atr, srLook)
    int tLoL  = f_touches(lonL, srTol * atr, srLook)
    int tNyH  = f_touches(nyH, srTol * atr, srLook)
    int tNyL  = f_touches(nyL, srTol * atr, srLook)
    if not na(lblPDH)
        label.delete(lblPDH)
    if drawLevels and usePoolPD and not na(pdh)
        lblPDH := label.new(xT, pdh, f_lvlTxt("PDH", tPDH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblPDL)
        label.delete(lblPDL)
    if drawLevels and usePoolPD and not na(pdl)
        lblPDL := label.new(xT, pdl, f_lvlTxt("PDL", tPDL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)
    if not na(lblPWH)
        label.delete(lblPWH)
    if drawLevels and usePoolPW and not na(pwh)
        lblPWH := label.new(xT, pwh, f_lvlTxt("PWH", tPWH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblPWL)
        label.delete(lblPWL)
    if drawLevels and usePoolPW and not na(pwl)
        lblPWL := label.new(xT, pwl, f_lvlTxt("PWL", tPWL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)
    if not na(lblPMH)
        label.delete(lblPMH)
    if drawLevels and usePoolPM and not na(pmh)
        lblPMH := label.new(xT, pmh, f_lvlTxt("PMH", tPMH, srTouches), style = label.style_label_left, color = color.new(color.purple, 90), textcolor = color.new(color.purple, 5), size = size.tiny)
    if not na(lblPML)
        label.delete(lblPML)
    if drawLevels and usePoolPM and not na(pml)
        lblPML := label.new(xT, pml, f_lvlTxt("PML", tPML, srTouches), style = label.style_label_left, color = color.new(color.purple, 90), textcolor = color.new(color.purple, 5), size = size.tiny)
    if not na(lblDOpen)
        label.delete(lblDOpen)
    if showOpens and not na(dOpenV)
        lblDOpen := label.new(xT, dOpenV, "D Open", style = label.style_label_left, color = color.new(color.gray, 90), textcolor = color.new(color.gray, 5), size = size.tiny)
    if not na(lblWOpen)
        label.delete(lblWOpen)
    if showOpens and not na(wOpenV)
        lblWOpen := label.new(xT, wOpenV, "W Open", style = label.style_label_left, color = color.new(color.orange, 90), textcolor = color.new(color.orange, 5), size = size.tiny)
    if not na(lblMOpen)
        label.delete(lblMOpen)
    if showOpens and not na(mOpenV)
        lblMOpen := label.new(xT, mOpenV, "M Open", style = label.style_label_left, color = color.new(color.purple, 90), textcolor = color.new(color.purple, 5), size = size.tiny)
    if not na(lblLastH)
        label.delete(lblLastH)
    if drawLevels and usePoolSess and not na(lastSessHi)
        lblLastH := label.new(xT, lastSessHi, f_lvlTxt(lastSessName + " H", tLstH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblLastL)
        label.delete(lblLastL)
    if drawLevels and usePoolSess and not na(lastSessLo)
        lblLastL := label.new(xT, lastSessLo, f_lvlTxt(lastSessName + " L", tLstL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)
    if not na(lblAsiaH)
        label.delete(lblAsiaH)
    if showSessHL and not na(asiaH)
        lblAsiaH := label.new(xT, asiaH, f_lvlTxt("Asia H", tAsH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblAsiaL)
        label.delete(lblAsiaL)
    if showSessHL and not na(asiaL)
        lblAsiaL := label.new(xT, asiaL, f_lvlTxt("Asia L", tAsL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)
    if not na(lblLonH)
        label.delete(lblLonH)
    if showSessHL and not na(lonH)
        lblLonH := label.new(xT, lonH, f_lvlTxt("London H", tLoH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblLonL)
        label.delete(lblLonL)
    if showSessHL and not na(lonL)
        lblLonL := label.new(xT, lonL, f_lvlTxt("London L", tLoL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)
    if not na(lblNyH)
        label.delete(lblNyH)
    if showSessHL and not na(nyH)
        lblNyH := label.new(xT, nyH, f_lvlTxt("NY H", tNyH, srTouches), style = label.style_label_left, color = color.new(colBear, 100), textcolor = color.new(colBear, 10), size = size.tiny)
    if not na(lblNyL)
        label.delete(lblNyL)
    if showSessHL and not na(nyL)
        lblNyL := label.new(xT, nyL, f_lvlTxt("NY L", tNyL, srTouches), style = label.style_label_left, color = color.new(colBull, 100), textcolor = color.new(colBull, 10), size = size.tiny)

// HTF trend candle coloring (green up / red down)
candleCol = candleColorMode == "HTF Trend" ? (htfcUp ? color.new(colBull, 25) : htfcDn ? color.new(colBear, 25) : na) : candleColorMode == "Volume Pressure" ? (volPressUp ? color.new(colBull, 10) : volPressDn ? color.new(colBear, 10) : na) : na
barcolor(candleCol)

// session shading — morning / noon per session, lunch hour left blank
inAsiaAM = not na(time(timeframe.period, asiaAM, sessTz))
inAsiaPM = not na(time(timeframe.period, asiaPM, sessTz))
inLonAM  = not na(time(timeframe.period, lonAM,  sessTz))
inLonPM  = not na(time(timeframe.period, lonPM,  sessTz))
inNyAM   = not na(time(timeframe.period, nyAM,   sessTz))
inNyPM   = not na(time(timeframe.period, nyPM,   sessTz))
inLunch  = blankLunch and (not na(time(timeframe.period, asiaLunch, sessTz)) or not na(time(timeframe.period, lonLunch, sessTz)) or not na(time(timeframe.period, nyLunch, sessTz)))
bgcolor(drawSess and inAsiaAM and not inLunch ? color.new(color.blue,   93) : na, title = "Asia morning")
bgcolor(drawSess and inAsiaPM and not inLunch ? color.new(color.blue,   88) : na, title = "Asia noon")
bgcolor(drawSess and inLonAM  and not inLunch ? color.new(colBull,  93) : na, title = "London morning")
bgcolor(drawSess and inLonPM  and not inLunch ? color.new(colBull,  88) : na, title = "London noon")
bgcolor(drawSess and inNyAM   and not inLunch ? color.new(color.orange, 93) : na, title = "New York morning")
bgcolor(drawSess and inNyPM   and not inLunch ? color.new(color.orange, 88) : na, title = "New York noon")

// big background session-name box — sized to THAT session's own running top/low.
// Pine's text size is a fixed ladder (tiny..huge), there's no continuous font
// scaling to price — huge is the ceiling. The BOX itself is the part that's
// truly sized by the session's high/low: it grows/shrinks with the session.
var box bigAsiaBox = na
var box bigLonBox  = na
var box bigNyBox   = na
if drawSess
    if inAsia and not inAsia[1]
        if not na(bigAsiaBox)
            box.delete(bigAsiaBox)
        bigAsiaBox := box.new(bar_index, high, bar_index, low, border_color = color.new(color.blue, 60), bgcolor = color.new(color.blue, 88), text = "ASIA", text_color = color.new(color.blue, 55), text_size = size.huge, text_halign = text.align_center, text_valign = text.align_center)
    else if inAsia and not na(bigAsiaBox)
        box.set_top(bigAsiaBox, math.max(box.get_top(bigAsiaBox), high))
        box.set_bottom(bigAsiaBox, math.min(box.get_bottom(bigAsiaBox), low))
        box.set_right(bigAsiaBox, bar_index)
    if inLon and not inLon[1]
        if not na(bigLonBox)
            box.delete(bigLonBox)
        bigLonBox := box.new(bar_index, high, bar_index, low, border_color = color.new(colBull, 60), bgcolor = color.new(colBull, 88), text = "LONDON", text_color = color.new(colBull, 55), text_size = size.huge, text_halign = text.align_center, text_valign = text.align_center)
    else if inLon and not na(bigLonBox)
        box.set_top(bigLonBox, math.max(box.get_top(bigLonBox), high))
        box.set_bottom(bigLonBox, math.min(box.get_bottom(bigLonBox), low))
        box.set_right(bigLonBox, bar_index)
    if inNY and not inNY[1]
        if not na(bigNyBox)
            box.delete(bigNyBox)
        bigNyBox := box.new(bar_index, high, bar_index, low, border_color = color.new(color.orange, 60), bgcolor = color.new(color.orange, 88), text = "NEW YORK", text_color = color.new(color.orange, 55), text_size = size.huge, text_halign = text.align_center, text_valign = text.align_center)
    else if inNY and not na(bigNyBox)
        box.set_top(bigNyBox, math.max(box.get_top(bigNyBox), high))
        box.set_bottom(bigNyBox, math.min(box.get_bottom(bigNyBox), low))
        box.set_right(bigNyBox, bar_index)

// ----- order blocks & FVGs: SEPARATE budgets so FVG proliferation can't evict OB
// Color language is consistent everywhere: green = demand/bullish, red = supply/bearish.
// Order blocks are rare and valuable -> their own array, own cap (obMaxKeep).
// FVGs form far more often on 1m gold -> their own smaller array (fvgMaxKeep) +
// a minimum-size filter (fvgMinAtr) so trivial gaps don't stack into a pile.
var array<box> demOBZones  = array.new<box>()
var array<box> supOBZones  = array.new<box>()
var array<box> demFVGZones = array.new<box>()
var array<box> supFVGZones = array.new<box>()
// HTF FVGs: own small arrays per timeframe × direction (htfFvgMaxKeep each) —
// same split as demFVGZones/supFVGZones so mitigation direction never needs a
// parallel tag array. No age-based eviction (zoneMaxAge is chart-timeframe-
// scaled and would age a 4H gap out too fast on a low chart timeframe) — the
// small FIFO cap plus mitigation-on-fill is the only eviction here.
var array<box> h1FvgDemZones = array.new<box>()
var array<box> h1FvgSupZones = array.new<box>()
var array<box> h4FvgDemZones = array.new<box>()
var array<box> h4FvgSupZones = array.new<box>()
if showOB and obBull
    if demOBZones.size() >= obMaxKeep
        box.delete(demOBZones.shift())
    bool   obHiD = showOBScore and obIsHPZ
    color  obColD = obHiD ? HPZ_BULL : colBull
    string obTxtD = "OB DEMAND" + (showOBScore ? " " + str.tostring(obScore, "#") + "%" + (obIsHPZ ? " ★HPZ" : "") : "")
    demOBZones.push(box.new(bar_index - 1, high[1], bar_index + 2, low[1], border_color = color.new(obColD, 20), bgcolor = color.new(obColD, 70), border_width = obHiD ? 2 : 1, border_style = line.style_solid, text = obTxtD, text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showOB and obBear
    if supOBZones.size() >= obMaxKeep
        box.delete(supOBZones.shift())
    bool   obHiS = showOBScore and obIsHPZ
    color  obColS = obHiS ? HPZ_BEAR : colBear
    string obTxtS = "OB SUPPLY" + (showOBScore ? " " + str.tostring(obScore, "#") + "%" + (obIsHPZ ? " ★HPZ" : "") : "")
    supOBZones.push(box.new(bar_index - 1, high[1], bar_index + 2, low[1], border_color = color.new(obColS, 20), bgcolor = color.new(obColS, 70), border_width = obHiS ? 2 : 1, border_style = line.style_solid, text = obTxtS, text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showFVG and fvgBull
    if demFVGZones.size() >= fvgMaxKeep
        box.delete(demFVGZones.shift())
    demFVGZones.push(box.new(bar_index - 2, low, bar_index + 2, high[2], border_color = color.new(colBull, 20), bgcolor = color.new(colBull, 78), border_width = 1, border_style = line.style_solid, text = "FVG DEMAND", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showFVG and fvgBear
    if supFVGZones.size() >= fvgMaxKeep
        box.delete(supFVGZones.shift())
    supFVGZones.push(box.new(bar_index - 2, low[2], bar_index + 2, high, border_color = color.new(colBear, 20), bgcolor = color.new(colBear, 78), border_width = 1, border_style = line.style_solid, text = "FVG SUPPLY", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showHtfFVG and newH1Bar and fvgBull1H
    if h1FvgDemZones.size() >= htfFvgMaxKeep
        box.delete(h1FvgDemZones.shift())
    h1FvgDemZones.push(box.new(bar_index - 1, h1L1, bar_index + 2, h1H3, border_color = color.new(colBull, 20), bgcolor = color.new(colBull, 82), border_width = 1, border_style = line.style_dashed, text = "1H FVG", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showHtfFVG and newH1Bar and fvgBear1H
    if h1FvgSupZones.size() >= htfFvgMaxKeep
        box.delete(h1FvgSupZones.shift())
    h1FvgSupZones.push(box.new(bar_index - 1, h1L3, bar_index + 2, h1H1, border_color = color.new(colBear, 20), bgcolor = color.new(colBear, 82), border_width = 1, border_style = line.style_dashed, text = "1H FVG", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showHtfFVG and newH4Bar and fvgBull4H
    if h4FvgDemZones.size() >= htfFvgMaxKeep
        box.delete(h4FvgDemZones.shift())
    h4FvgDemZones.push(box.new(bar_index - 1, h4L1, bar_index + 2, h4H3, border_color = color.new(colBull, 20), bgcolor = color.new(colBull, 82), border_width = 2, border_style = line.style_dashed, text = "4H FVG", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
if showHtfFVG and newH4Bar and fvgBear4H
    if h4FvgSupZones.size() >= htfFvgMaxKeep
        box.delete(h4FvgSupZones.shift())
    h4FvgSupZones.push(box.new(bar_index - 1, h4L3, bar_index + 2, h4H1, border_color = color.new(colBear, 20), bgcolor = color.new(colBear, 82), border_width = 2, border_style = line.style_dashed, text = "4H FVG", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
// Breaker blocks: an OB that gets genuinely CLOSED THROUGH (not just aged out)
// flips into support/resistance in the opposite direction — real ICT concept.
// Own bounded arrays + own aging/mitigation loop below (deleted once price
// closes back through them too — a used breaker doesn't keep flipping forever).
if demOBZones.size() > 0
    for i = demOBZones.size() - 1 to 0
        box bd = demOBZones.get(i)
        bool brokenThru = close < box.get_bottom(bd)
        if brokenThru or bar_index - box.get_left(bd) > zoneMaxAge
            if brokenThru and showBreakers
                if bearBreakers.size() >= breakerMaxKeep
                    box.delete(bearBreakers.shift())
                bearBreakers.push(box.new(box.get_left(bd), box.get_top(bd), bar_index + 2, box.get_bottom(bd), border_color = color.new(colBear, 30), bgcolor = color.new(colBear, 85), border_width = 1, border_style = line.style_solid, text = "BREAKER", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
            box.delete(bd)
            demOBZones.remove(i)
        else
            box.set_right(bd, bar_index + 2)
if supOBZones.size() > 0
    for i = supOBZones.size() - 1 to 0
        box bs = supOBZones.get(i)
        bool brokenThru = close > box.get_top(bs)
        if brokenThru or bar_index - box.get_left(bs) > zoneMaxAge
            if brokenThru and showBreakers
                if bullBreakers.size() >= breakerMaxKeep
                    box.delete(bullBreakers.shift())
                bullBreakers.push(box.new(box.get_left(bs), box.get_top(bs), bar_index + 2, box.get_bottom(bs), border_color = color.new(colBull, 30), bgcolor = color.new(colBull, 85), border_width = 1, border_style = line.style_solid, text = "BREAKER", text_color = color.new(color.white, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center))
            box.delete(bs)
            supOBZones.remove(i)
        else
            box.set_right(bs, bar_index + 2)
if bullBreakers.size() > 0
    for i = bullBreakers.size() - 1 to 0
        box bb = bullBreakers.get(i)
        if close < box.get_bottom(bb) or bar_index - box.get_left(bb) > zoneMaxAge
            box.delete(bb)
            bullBreakers.remove(i)
        else
            box.set_right(bb, bar_index + 2)
if bearBreakers.size() > 0
    for i = bearBreakers.size() - 1 to 0
        box bb = bearBreakers.get(i)
        if close > box.get_top(bb) or bar_index - box.get_left(bb) > zoneMaxAge
            box.delete(bb)
            bearBreakers.remove(i)
        else
            box.set_right(bb, bar_index + 2)
if demFVGZones.size() > 0
    for i = demFVGZones.size() - 1 to 0
        box bd = demFVGZones.get(i)
        if close < box.get_bottom(bd) or bar_index - box.get_left(bd) > zoneMaxAge
            box.delete(bd)
            demFVGZones.remove(i)
        else
            box.set_right(bd, bar_index + 2)
if supFVGZones.size() > 0
    for i = supFVGZones.size() - 1 to 0
        box bs = supFVGZones.get(i)
        if close > box.get_top(bs) or bar_index - box.get_left(bs) > zoneMaxAge
            box.delete(bs)
            supFVGZones.remove(i)
        else
            box.set_right(bs, bar_index + 2)
if h1FvgDemZones.size() > 0
    for i = h1FvgDemZones.size() - 1 to 0
        box bd = h1FvgDemZones.get(i)
        if close < box.get_bottom(bd)
            box.delete(bd)
            h1FvgDemZones.remove(i)
        else
            box.set_right(bd, bar_index + 2)
if h1FvgSupZones.size() > 0
    for i = h1FvgSupZones.size() - 1 to 0
        box bs = h1FvgSupZones.get(i)
        if close > box.get_top(bs)
            box.delete(bs)
            h1FvgSupZones.remove(i)
        else
            box.set_right(bs, bar_index + 2)
if h4FvgDemZones.size() > 0
    for i = h4FvgDemZones.size() - 1 to 0
        box bd = h4FvgDemZones.get(i)
        if close < box.get_bottom(bd)
            box.delete(bd)
            h4FvgDemZones.remove(i)
        else
            box.set_right(bd, bar_index + 2)
if h4FvgSupZones.size() > 0
    for i = h4FvgSupZones.size() - 1 to 0
        box bs = h4FvgSupZones.get(i)
        if close > box.get_top(bs)
            box.delete(bs)
            h4FvgSupZones.remove(i)
        else
            box.set_right(bs, bar_index + 2)

// ----- liquidity-direction projection: where the sweep happened, where it's headed
var line  liqProjLn  = na
var label liqProjLbl = na
if armBullNow or armBearNow
    if not na(liqProjLn)
        line.delete(liqProjLn)
    if not na(liqProjLbl)
        label.delete(liqProjLbl)
    float sweptPx = armBullNow ? swpLoPrice : swpHiPrice
    color projCol = armBullNow ? color.new(colBull, 20) : color.new(colBear, 20)
    [projT, projN] = f_nextPool(armBullNow ? 1 : -1, sweptPx, pdh, pdl, pwh, pwl, lastSessHi, lastSessLo, lastSessName, asiaH, asiaL)
    if not na(projT)
        liqProjLn := line.new(bar_index, sweptPx, bar_index, projT, color = projCol, width = 2, style = line.style_dotted, extend = extend.none)
        liqProjLbl := label.new(bar_index, projT, "🎯 " + projN, style = armBullNow ? label.style_label_down : label.style_label_up, color = projCol, textcolor = color.white, size = size.tiny)
if not na(liqProjLn)
    if pendDir != 0
        line.set_x2(liqProjLn, bar_index)
    else
        line.delete(liqProjLn)
        liqProjLn := na
        if not na(liqProjLbl)
            label.delete(liqProjLbl)
            liqProjLbl := na

// ----- entry FVG (strict ICT): highlight the displacement FVG the setup is
// waiting to retrace into — distinct from the ordinary FVG boxes above.
var box entryFvgBox = na
if strictICT and pendDir != 0 and not na(fvgEBar)
    if na(entryFvgBox)
        entryFvgBox := box.new(fvgEBar - 2, fvgETop, bar_index + 2, fvgEBot, border_color = color.new(color.yellow, 10), bgcolor = color.new(color.yellow, 80), border_width = 2, text = "ENTRY FVG", text_color = color.new(color.yellow, 0), text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center)
    else
        box.set_right(entryFvgBox, bar_index + 2)
else if not na(entryFvgBox)
    box.delete(entryFvgBox)
    entryFvgBox := na

// ----- BOS / CHoCH / MSS lines, name centered on the line, bounded history ----
// Standard color rule: up = green, down = red, everywhere. Significance is
// carried by WEIGHT/STYLE instead of hue: CHoCH (thick solid) > BOS (solid) >
// MSS (thin dotted, small text) — the most important event still pops the most.
var array<line>  structLines  = array.new<line>()
var array<label> structLabels = array.new<label>()
if showStructure and barstate.isconfirmed
    if isBosUp
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(extPHBar, extPHVal, bar_index, extPHVal, color = color.new(colBull, 20), width = 1))
        structLabels.push(label.new(math.round((extPHBar + bar_index) / 2), extPHVal, "BOS ▲", style = label.style_none, color = na, textcolor = color.new(colBull, 0), size = size.small))
    if isBosDn
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(extPLBar, extPLVal, bar_index, extPLVal, color = color.new(colBear, 20), width = 1))
        structLabels.push(label.new(math.round((extPLBar + bar_index) / 2), extPLVal, "BOS ▼", style = label.style_none, color = na, textcolor = color.new(colBear, 0), size = size.small))
    if isChochUp
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(extPHBar, extPHVal, bar_index, extPHVal, color = color.new(colBull, 0), width = 3))
        structLabels.push(label.new(math.round((extPHBar + bar_index) / 2), extPHVal, "CHoCH ▲", style = label.style_none, color = na, textcolor = color.new(colBull, 0), size = size.small))
    if isChochDn
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(extPLBar, extPLVal, bar_index, extPLVal, color = color.new(colBear, 0), width = 3))
        structLabels.push(label.new(math.round((extPLBar + bar_index) / 2), extPLVal, "CHoCH ▼", style = label.style_none, color = na, textcolor = color.new(colBear, 0), size = size.small))
    if isMssUp
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(minPHBar, minPHVal, bar_index, minPHVal, color = color.new(colBull, 55), width = 1, style = line.style_dotted))
        structLabels.push(label.new(math.round((minPHBar + bar_index) / 2), minPHVal, "MSS ▲", style = label.style_none, color = na, textcolor = color.new(colBull, 35), size = size.tiny))
    if isMssDn
        if structLines.size() >= structMaxKeep
            line.delete(structLines.shift())
            label.delete(structLabels.shift())
        structLines.push(line.new(minPLBar, minPLVal, bar_index, minPLVal, color = color.new(colBear, 55), width = 1, style = line.style_dotted))
        structLabels.push(label.new(math.round((minPLBar + bar_index) / 2), minPLVal, "MSS ▼", style = label.style_none, color = na, textcolor = color.new(colBear, 35), size = size.tiny))

// ----- EQH / EQL: a horizontal tie-line between the two equal swings, name at
// the midpoint — matches the BOS/CHoCH label-centering convention.
var array<line>  eqLines  = array.new<line>()
var array<label> eqLabels = array.new<label>()
if showEQ and barstate.isconfirmed
    if eqhNew
        if eqLines.size() >= 10
            line.delete(eqLines.shift())
            label.delete(eqLabels.shift())
        eqLines.push(line.new(eqhBar, eqhLvl, bar_index, eqhLvl, color = color.new(colBear, 20), width = 2, style = line.style_solid))
        eqLabels.push(label.new(math.round((eqhBar + bar_index) / 2), eqhLvl, "EQH", style = label.style_none, color = na, textcolor = color.new(colBear, 0), size = size.small))
    if eqlNew
        if eqLines.size() >= 10
            line.delete(eqLines.shift())
            label.delete(eqLabels.shift())
        eqLines.push(line.new(eqlBar, eqlLvl, bar_index, eqlLvl, color = color.new(colBull, 20), width = 2, style = line.style_solid))
        eqLabels.push(label.new(math.round((eqlBar + bar_index) / 2), eqlLvl, "EQL", style = label.style_none, color = na, textcolor = color.new(colBull, 0), size = size.small))

// ----- HH / HL / LL / LH tags, offset off the candle so they don't sit on the
// horizontal BOS/CHoCH lines at the same price. Mechanical (not subjective).
var array<label> swingHLLabels = array.new<label>()
if showSwingHL and barstate.isconfirmed
    if not na(extPH)
        if swingHLLabels.size() >= 20
            label.delete(swingHLLabels.shift())
        color hiCol = hiSwingLabel == "HH" ? color.new(colBull, 0) : hiSwingLabel == "LH" ? color.new(colBear, 0) : color.new(color.gray, 30)
        swingHLLabels.push(label.new(extPHBar, extPHVal, hiSwingLabel, style = label.style_none, yloc = yloc.abovebar, color = na, textcolor = hiCol, size = size.tiny))
    if not na(extPL)
        if swingHLLabels.size() >= 20
            label.delete(swingHLLabels.shift())
        color loCol = loSwingLabel == "HL" ? color.new(colBull, 0) : loSwingLabel == "LL" ? color.new(colBear, 0) : color.new(color.gray, 30)
        swingHLLabels.push(label.new(extPLBar, extPLVal, loSwingLabel, style = label.style_none, yloc = yloc.belowbar, color = na, textcolor = loCol, size = size.tiny))

// ----- CISD: line at the reference open, name at the confirmation (right end) -
var array<line>  cisdLines  = array.new<line>()
var array<label> cisdLabels = array.new<label>()
if showCISD and barstate.isconfirmed
    if cisdBullConfirm
        if cisdLines.size() >= 20
            line.delete(cisdLines.shift())
            label.delete(cisdLabels.shift())
        cisdLines.push(line.new(cisdBullBar, cisdBullLvl, bar_index, cisdBullLvl, color = color.new(colBull, 0), width = 2))
        cisdLabels.push(label.new(bar_index, cisdBullLvl, "CISD", style = label.style_none, color = na, textcolor = color.new(colBull, 0), size = size.small))
    if cisdBearConfirm
        if cisdLines.size() >= 20
            line.delete(cisdLines.shift())
            label.delete(cisdLabels.shift())
        cisdLines.push(line.new(cisdBearBar, cisdBearLvl, bar_index, cisdBearLvl, color = color.new(colBear, 0), width = 2))
        cisdLabels.push(label.new(bar_index, cisdBearLvl, "CISD", style = label.style_none, color = na, textcolor = color.new(colBear, 0), size = size.small))

// ----- price-action zigzag: connects the same external swings as BOS/CHoCH ---
// Green = rising leg (up), red = falling leg (down) — the mechanical, non-
// repainting substitute for Elliott Wave (see input tooltip for why).
var float zzLastVal = na
var int   zzLastBar = na
var array<line> zzLines = array.new<line>()
if showZigzag and barstate.isconfirmed
    if not na(extPH)
        if not na(zzLastVal)
            if zzLines.size() >= structMaxKeep
                line.delete(zzLines.shift())
            zzLines.push(line.new(zzLastBar, zzLastVal, extPHBar, extPHVal, color = extPHVal > zzLastVal ? color.new(colBull, 0) : color.new(colBear, 0), width = 2))
        zzLastVal := extPHVal
        zzLastBar := extPHBar
    if not na(extPL)
        if not na(zzLastVal)
            if zzLines.size() >= structMaxKeep
                line.delete(zzLines.shift())
            zzLines.push(line.new(zzLastBar, zzLastVal, extPLBar, extPLVal, color = extPLVal > zzLastVal ? color.new(colBull, 0) : color.new(colBear, 0), width = 2))
        zzLastVal := extPLVal
        zzLastBar := extPLBar

// ----- premium (favor selling, red) / discount (favor buying, green) / equilibrium
var box   pdPremBox = na
var box   pdDiscBox = na
var line  pdEqLine  = na
var label pdEqLbl   = na
var box   pdOteBox  = na
if showPremDisc and pdHasRange
    // OTE band tracks the CURRENT structural trend: bullish -> the pullback zone
    // buyers would want (in the discount half), bearish -> the rally zone sellers
    // would want (in the premium half). Same "golden ratio" range either way.
    float oteTop = structTrend == 1 ? oteLongTop : oteShortTop
    float oteBot = structTrend == 1 ? oteLongBot : oteShortBot
    if na(pdPremBox)
        pdPremBox := box.new(pdLeftBar, pdRangeTop, bar_index, pdEq, border_color = na, bgcolor = color.new(colBear, 88), text = "PREMIUM", text_color = color.new(colBear, 30), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        pdDiscBox := box.new(pdLeftBar, pdEq, bar_index, pdRangeBot, border_color = na, bgcolor = color.new(colBull, 88), text = "DISCOUNT", text_color = color.new(colBull, 30), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        pdEqLine := line.new(pdLeftBar, pdEq, bar_index, pdEq, color = color.new(color.gray, 40), style = line.style_dashed, width = 1)
        pdEqLbl := label.new(bar_index, pdEq, "Equilibrium", style = label.style_none, color = na, textcolor = color.new(color.gray, 20), size = size.tiny)
        pdOteBox := box.new(pdLeftBar, oteTop, bar_index, oteBot, border_color = color.new(color.yellow, 30), bgcolor = color.new(color.yellow, 80), border_width = 1, border_style = line.style_solid, text = "OTE", text_color = color.new(color.yellow, 5), text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
    else
        box.set_left(pdPremBox, pdLeftBar)
        box.set_top(pdPremBox, pdRangeTop)
        box.set_bottom(pdPremBox, pdEq)
        box.set_right(pdPremBox, bar_index)
        box.set_left(pdDiscBox, pdLeftBar)
        box.set_top(pdDiscBox, pdEq)
        box.set_bottom(pdDiscBox, pdRangeBot)
        box.set_right(pdDiscBox, bar_index)
        line.set_xy1(pdEqLine, pdLeftBar, pdEq)
        line.set_xy2(pdEqLine, bar_index, pdEq)
        label.set_xy(pdEqLbl, bar_index, pdEq)
        box.set_left(pdOteBox, pdLeftBar)
        box.set_top(pdOteBox, oteTop)
        box.set_bottom(pdOteBox, oteBot)
        box.set_right(pdOteBox, bar_index)

var box   bxSL    = na
var box   bxTP    = na
var line  lnEnt   = na
var label lbBadge = na
var label lbSL    = na
var label lbTP    = na
if longSig or shortSig
    if not na(bxSL)
        box.delete(bxSL)
    if not na(bxTP)
        box.delete(bxTP)
    if not na(lnEnt)
        line.delete(lnEnt)
    if not na(lbBadge)
        label.delete(lbBadge)
    if not na(lbSL)
        label.delete(lbSL)
    if not na(lbTP)
        label.delete(lbTP)
    int xR = bar_index + 5
    bxSL := box.new(bar_index, math.max(entryP, slP), xR, math.min(entryP, slP), border_color = color.new(colBear, 50), bgcolor = color.new(colBear, 85))
    bxTP := box.new(bar_index, math.max(entryP, tpP), xR, math.min(entryP, tpP), border_color = color.new(colBull, 50), bgcolor = color.new(colBull, 85))
    lnEnt := line.new(bar_index, entryP, xR, entryP, color = color.new(color.blue, 0), width = 2, style = line.style_dashed)
    lbBadge := label.new(bar_index, entryP, (dir == 1 ? "BUY " : "SELL ") + "1:" + str.tostring(tradeRR, "#.#"), style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.new(colBull, 0) : color.new(colBear, 0), textcolor = color.white, size = size.small)
    lbSL := label.new(xR, slP, "SL " + str.tostring(slP, "#.##") + (entryGuardFired ? " ⚠DPG" : ""), style = label.style_label_left, color = color.new(colBear, 10),   textcolor = color.white, size = size.small)
    lbTP := label.new(xR, tpP, "TP " + str.tostring(tpP, "#.##"), style = label.style_label_left, color = color.new(colBull, 10), textcolor = color.white, size = size.small)
else if inTrade and not na(bxSL)
    int xR = bar_index + 5
    box.set_right(bxSL, xR)
    box.set_right(bxTP, xR)
    box.set_top(bxSL, math.max(entryP, slP))
    box.set_bottom(bxSL, math.min(entryP, slP))
    line.set_x2(lnEnt, xR)
    label.set_xy(lbSL, xR, slP)
    label.set_text(lbSL, "SL " + str.tostring(slP, "#.##") + (entryGuardFired ? " ⚠DPG" : ""))
    label.set_x(lbTP, xR)

plotshape(sweepLoNow, "Swept low",  shape.triangleup,   location.belowbar, color.new(colBull, 0), size = size.tiny)
plotshape(sweepHiNow, "Swept high", shape.triangledown, location.abovebar, color.new(colBear, 0),   size = size.tiny)
plotshape(longSig,  "BUY",  shape.labelup,   location.belowbar, color.new(colBull, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(shortSig, "SELL", shape.labeldown, location.abovebar, color.new(colBear, 0),   text = "SELL", textcolor = color.white, size = size.small)
plotshape(tpHit,    "TP",   shape.circle, location.belowbar, color.new(colBull, 0), size = size.tiny)
plotshape(slHit,    "SL",   shape.xcross, location.abovebar, color.new(colBear, 0),   size = size.tiny)
plotshape(exitEarly,"Exit", shape.square, location.abovebar, color.new(color.gray, 0),  size = size.tiny)

// ============================== DASHBOARD ====================================
f_pos() => dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table dash = table.new(f_pos(), 2, 19, border_width = 1, frame_color = color.new(color.gray, 40), frame_width = 1)
if showDash and barstate.islast
    cW = color.white
    sessTxt = inNY ? "New York" : inLon ? "London" : inAsia ? "Asia" : "—"
    liveHint = ((sweepLoNow or sweepHiNow) ? "⚡ sweeping" : inSession ? "forming" : "—") + "  " + (pressBull ? "▲press" : pressBear ? "▼press" : "")
    expC = lastSessPhase == "Manip" ? color.new(colBull, 20) : lastSessPhase == "Accum" ? color.new(color.orange, 20) : color.new(color.gray, 30)
    fStr =(requireBias ? "B" + f_chk(biasBull or biasBear) + " " : "") + (requireChoch ? "C" + f_chk(chochArmBull or chochArmBear) + " " : "") + (requireSMT ? "SMT" + f_chk(smtBull or smtBear) + " " : "") + (useStrongSR ? "SR" + f_chk(strongLo or strongHi) + " " : "") + (requirePress ? "P" + f_chk(pressBull or pressBear) + " " : "") + (requireOTE ? "OTE" + f_chk(oteOkBull or oteOkBear) : "") + (useDeeperGuard ? " DPG" : "")
    fStr := fStr == "" ? "soft (none)" : fStr
    pendTxt = not strictICT ? "⌛ wait retest" : na(fvgEBar) and not confStruct ? "⌛ wait displacement" : na(fvgEBar) ? "⌛ wait FVG" : not confStruct ? "⌛ wait CISD/MSS" : "⌛ wait FVG retest"
    verdict = trigBull ? "⚑ BUY" : trigBear ? "⚑ SELL" : inTrade ? (dir == 1 ? "● LONG" : "● SHORT") : pendDir != 0 ? pendTxt + (pendDir == 1 ? " ▲" : " ▼") + (pendMajorVol ? " [MAJOR]" : " [minor]") : "WAIT"
    verdictC= trigBull ? color.new(colBull, 0) : trigBear ? color.new(colBear, 0) : inTrade ? color.new(color.blue, 10) : pendDir != 0 ? color.new(color.orange, 20) : color.new(color.gray, 30)
    table.cell(dash, 0, 0, "APEX SESSION SMC (adaptive + DPG)", text_color = cW, bgcolor = color.new(color.blue, 10), text_size = size.small)
    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 1, "Session", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 1, sessTxt + " · " + liveHint, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 2, "Phases today", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 2, "A:" + asiaPhase + " L:" + lonPhase + " N:" + nyPhase, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 3, "Last session", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 3, lastSessName + " = " + lastSessPhase, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 4, "EXPECT next", text_color = cW, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 4, expectTxt, text_color = cW, bgcolor = expC, text_size = size.small)
    table.cell(dash, 0, 5, "— ENTRY —", text_color = cW, bgcolor = color.new(color.gray, 60), text_size = size.small)
    table.merge_cells(dash, 0, 5, 1, 5)
    table.cell(dash, 0, 6, "Pool swept", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 6, (sweepLoNow or sweepHiNow ? "✓ " : "✗ ") + (sweepLoNow ? swLoName : sweepHiNow ? swHiName : ""), text_color = (sweepLoNow or sweepHiNow) ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 7, "Candle", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 7, f_chk((bullConf or bearConf) and not isDoji) + " " + cndName, text_color = (bullConf or bearConf) ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 8, "Filters", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 8, fStr, text_color = cW, text_size = size.small)
    table.cell(dash, 0, 9, "VERDICT", text_color = cW, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 9, verdict, text_color = cW, bgcolor = verdictC, text_size = size.small)
    table.cell(dash, 0, 10, "Entry", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 10, inTrade ? str.tostring(entryP, "#.##") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 11, "TP / SL", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 11, inTrade ? str.tostring(tpP, "#.#") + " / " + str.tostring(slP, "#.#") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 12, "Risk / RR", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 12, inTrade ? str.tostring(riskDist, "#.#") + " / 1:" + str.tostring(tradeRR, "#.#") : "—", text_color = cW, text_size = size.small)
    table.cell(dash, 0, 13, "— SESSION ROLES (A/M/D) —", text_color = cW, bgcolor = color.new(color.gray, 60), text_size = size.small)
    table.merge_cells(dash, 0, 13, 1, 13)
    table.cell(dash, 0, 14, "Asia", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 14, str.tostring(aA) + " / " + str.tostring(aM) + " / " + str.tostring(aD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 15, "London", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 15, str.tostring(lA) + " / " + str.tostring(lM) + " / " + str.tostring(lD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 16, "New York", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 16, str.tostring(nA) + " / " + str.tostring(nM) + " / " + str.tostring(nD), text_color = cW, text_size = size.small)
    table.cell(dash, 0, 17, "Trades W% / PF", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
    table.cell(dash, 1, 17, str.tostring(nT) + " " + str.tostring(winRate, "#") + "% / " + str.tostring(pf, "#.##"), text_color = pf >= 1 ? colBull : colBear, text_size = size.small)
    if showMTF
        table.cell(dash, 0, 18, "MTF 5·15·1h·4h·1D", text_color = color.gray, text_halign = text.align_left, text_size = size.small)
        table.cell(dash, 1, 18, f_mtfArrow(mtf5t) + " " + f_mtfArrow(mtf15t) + " " + f_mtfArrow(mtf60t) + " " + f_mtfArrow(mtf240t) + " " + f_mtfArrow(mtfDt) + "  (" + str.tostring(mtfAgree) + "/5)", text_color = mtfAgree > 0 ? colBull : mtfAgree < 0 ? colBear : color.gray, text_size = size.small)

// ============================== ALERTS =======================================
if longSig
    alert("APEX SMC BUY " + syminfo.ticker + " @ " + str.tostring(entryP, "#.##") + " | SL " + str.tostring(slP, "#.##") + " | TP " + str.tostring(tpP, "#.##") + " | 1:" + str.tostring(tradeRR, "#.#"), alert.freq_once_per_bar_close)
if shortSig
    alert("APEX SMC SELL " + syminfo.ticker + " @ " + str.tostring(entryP, "#.##") + " | SL " + str.tostring(slP, "#.##") + " | TP " + str.tostring(tpP, "#.##") + " | 1:" + str.tostring(tradeRR, "#.#"), alert.freq_once_per_bar_close)
alertcondition(longSig,  "SMC Long Entry",  "Apex SMC BUY")
alertcondition(shortSig, "SMC Short Entry", "Apex SMC SELL")
